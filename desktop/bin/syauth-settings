    def build_system_status(self, main):
        main.addWidget(
            self.section_title(
                _("STATO SISTEMA")
            )
        )

        card = self.card()

        layout = QVBoxLayout(card)
        layout.setContentsMargins(18, 10, 18, 10)
        layout.setSpacing(1)

        self.bluetooth_row = StatusRow(
            "Bluetooth"
        )

        self.bond_row = StatusRow(
            _("Associazione")
        )

        self.unlock_row = StatusRow(
            _("Ultimo sblocco")
        )

        self.proximity_system_row = StatusRow(
            "Proximity Lock"
        )

        # Phone-as-key biometric unlock: the fingerprint icon is the
        # at-a-glance signal that the session can be unlocked from the phone
        # (the phone performs the actual biometric check).
        self.fingerprint_row = StatusRow(
            _("Sblocco con impronta"),
            icon_name="fingerprint",
        )

        for row in (
            self.bluetooth_row,
            self.bond_row,
            self.unlock_row,
            self.proximity_system_row,
            self.fingerprint_row,
        ):
            layout.addWidget(row)

        main.addWidget(card)

    def refresh(self):
        master = get_master_state()
        data = get_syauth_state()
        proximity = get_proximity_state()
        idle = get_idle_settings()

        self.idle_toggle.blockSignals(True)
        self.idle_toggle.setChecked(idle["enabled"])
        self.idle_toggle.blockSignals(False)
        self.idle_minutes.blockSignals(True)
        self.idle_minutes.setValue(idle["minutes"])
        self.idle_minutes.setEnabled(idle["enabled"])
        self.idle_minutes.blockSignals(False)

        self.proximity_toggle.blockSignals(True)
        self.proximity_toggle.setChecked(proximity["enabled"])
        self.proximity_toggle.blockSignals(False)

        self.proximity_profile.blockSignals(True)
        profile_index = self.proximity_profile.findData(
            proximity["profile_id"]
        )
        if profile_index >= 0:
            self.proximity_profile.setCurrentIndex(profile_index)
        self.proximity_profile.blockSignals(False)

        proximity_label, proximity_active = proximity_display_state(proximity)
        self.proximity_state.setText(proximity_label)
        self.proximity_system_row.set_status(
            proximity_active,
            _("Attivo") if proximity_active else proximity_label,
        )
        if proximity["available"] and proximity["enabled"]:
            self.proximity_state.setStyleSheet(
                "color: #63c174;"
                if proximity["state"] == "NEAR"
                else "color: #aeb4bc;"
            )
        else:
            self.proximity_state.setStyleSheet("color: #e06c75;")

        if master == "on":
            self.master_state.setText(
                _("●  DeskUnlock attivo")
            )

            self.master_state.setStyleSheet(
                "color: #63c174;"
            )

            self.toggle_button.setText(
                _("Disattiva")
            )

        elif master == "off":
            self.master_state.setText(
                _("○  DeskUnlock disattivato")
            )

            self.master_state.setStyleSheet(
                "color: #aeb4bc;"
            )

            self.toggle_button.setText(
                _("Attiva")
            )

        else:
            self.master_state.setText(
                _("●  Stato degradato")
            )

            self.master_state.setStyleSheet(
                "color: #d5a14f;"
            )

            self.toggle_button.setText(
                _("Ripristina")
            )

        phone = get_phone_info()

        self.phone_name.setText(
            phone["name"]
            if data["bonded"] > 0
            else _("Nessun dispositivo associato")
        )

        self.device_action.hide()
        self.device_revoke.hide()

        if data["bonded"] == 0:
            self.phone_state.setText(
                _("DeskUnlock non ha un telefono configurato")
            )
            self.phone_state.setStyleSheet(
                "color: #e06c75;"
            )

            self.device_action.setText(
                _("Associa telefono")
            )
            self.device_action.setProperty(
                "action", "pair"
            )
            self.device_action.show()

        elif master == "degraded":
            self.phone_state.setText(
                _("Associazione presente · Problema DeskUnlock")
            )
            self.phone_state.setStyleSheet(
                "color: #e06c75;"
            )

            self.device_action.setText(
                _("Controlla")
            )
            self.device_action.setProperty(
                "action", "doctor"
            )
            self.device_action.show()

        elif phone["connected"] is None:
            self.phone_state.setText(_("Associato"))
            self.phone_state.setProperty("role", "hint")

        elif phone["connected"]:
            self.phone_state.setText(
                _("Associato · Connesso")
            )
            self.phone_state.setStyleSheet(
                "color: #63c174;"
            )

        else:
            self.phone_state.setText(
                _("Associato · Non connesso")
            )
            self.phone_state.setStyleSheet(
                "color: #aeb4bc;"
            )

        if data["bonded"] > 0:
            self.device_revoke.show()

            if master != "degraded":
                self.device_action.setText(
                    _("Cambia telefono")
                )
                self.device_action.setProperty(
                    "action", "change"
                )
                self.device_action.show()

        self.bluetooth_row.set_status(
            data["bluetooth"],
            _("Disponibile")
            if data["bluetooth"]
            else _("Non disponibile"),
        )

        # "Associato" means the phone is actually reachable, not merely that a
        # bond file exists on disk.
        association_label, associated = association_display(
            data["bonded"], phone_present()
        )

        self.bond_row.set_status(
            associated,
            association_label,
        )

        unlock_label, unlock_ok = last_unlock_display(
            data["last_unlock"], associated
        )

        self.unlock_row.set_status(
            unlock_ok,
            unlock_label,
        )

        # The phone unlock row reports the real state, not just "the tree is
        # patched on disk": master on, a bonded phone, a fully adapted lock
        # tree, the runtime marker, and a DMS that actually loaded the patch.
        phone_unlock_armed, phone_unlock_reason = fingerprint_unlock_health(
            master,
            data["bonded"],
        )
        self.fingerprint_row.set_status(
            phone_unlock_armed,
            phone_unlock_reason,
        )

        self.toggle_button.setEnabled(
            not self.busy
        )
        self.device_action.setEnabled(not self.busy)
        self.device_revoke.setEnabled(not self.busy)

    def run_background_command(self, program, arguments, title):
        if self.command_process is not None:
            return

        self.busy = True
        self.command_title = title
        self.command_process = QProcess(self)
        self.command_process.setProcessChannelMode(
            QProcess.ProcessChannelMode.MergedChannels
        )
        self.command_process.finished.connect(
            self.background_command_finished
        )
        self.command_process.start(program, arguments)
        self.refresh()

    def background_command_finished(self, exit_code, _exit_status):
        process = self.command_process
        if process is None:
            return

        output = bytes(process.readAllStandardOutput()).decode(
            "utf-8",
            "replace",
        ).strip()
        process.deleteLater()
        self.command_process = None
        self.busy = False

        if exit_code == 0:
            QMessageBox.information(
                self,
                self.command_title,
                output or _("Operazione completata."),
            )
        else:
            QMessageBox.critical(
                self,
                self.command_title,
                output or _("Operazione non riuscita."),
            )
        self.refresh()

    def device_action_clicked(self):
        action = self.device_action.property(
            "action"
        )

        if action in ("pair", "change"):
            dialog = PairingDialog(self, action)
            dialog.exec()
            dialog.deleteLater()
            self.refresh()
        elif action == "doctor":
            self.run_background_command(
                "syauth",
                ["doctor"],
                _("Controllo DeskUnlock"),
            )

    def revoke_device_clicked(self):
        answer = QMessageBox.question(
            self,
            _("Dissocia telefono"),
            _(
                "Dissociare il telefono da DeskUnlock?\n\n"
                "Non potrà più autenticare o sbloccare "
                "questo computer.\n"
                "La password Linux resterà disponibile.\n\n"
                "Il normale pairing Bluetooth non verrà eliminato."
            ),
            QMessageBox.StandardButton.Yes
            | QMessageBox.StandardButton.Cancel,
            QMessageBox.StandardButton.Cancel,
        )

        if answer != QMessageBox.StandardButton.Yes:
            return

        try:
            result = subprocess.run(
                [
                    str(DEVICE_CONTROL),
                    "revoke",
                ],
                capture_output=True,
                text=True,
                timeout=15,
                check=False,
            )
        except Exception as exc:
            QMessageBox.critical(
                self,
                "Errore",
                "Dissociazione non riuscita.\n\n"
                + str(exc),
            )
            return

        if result.returncode != 0:
            message = (
                result.stderr.strip()
                or result.stdout.strip()
                or _("Errore sconosciuto.")
            )
            QMessageBox.critical(
                self,
                "Dissociazione non riuscita",
                message,
            )
            return

        QMessageBox.information(
            self,
            _("Telefono dissociato"),
            (
                _("Il telefono è stato dissociato da DeskUnlock.\n\n"
                "Puoi associarne un altro con "
                "\"Associa telefono\".")
            ),
        )
        self.refresh()

    def toggle_master(self):
        if self.busy:
            return

        self.busy = True

        self.toggle_button.setEnabled(False)
        self.toggle_button.setText(
            _("Attendere…")
        )

        current = get_master_state()

        if current == "on":
            action = "off"
        else:
            action = "on"

        self.process = QProcess(self)

        self.process.finished.connect(
            self.toggle_finished
        )

        self.process.start(
            str(CONTROL),
            [action],
        )

    def toggle_finished(self, *_):
        if self.process:
            self.process.deleteLater()
            self.process = None

        self.busy = False

        QTimer.singleShot(
            400,
            self.refresh,
        )


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("DeskUnlock Settings")
    app.setDesktopFileName("syauth")
    # Install the catalog before any label is built: every widget below captures
    # its text once, so translating after construction would only affect the
    # strings refreshed later. This is also why the language selector cannot
    # apply live.
    install_translations(resolve_language(os.environ))
    apply_theme(app, read_gui_theme())
    window = SettingsWindow()
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
