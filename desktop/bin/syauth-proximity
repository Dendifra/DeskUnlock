#!/usr/bin/env bash
set -u

export LC_ALL=C

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
RUNTIME_SUBDIR="$RUNTIME_DIR/syauth"
RUNTIME_STATE="$RUNTIME_SUBDIR/proximity.state"
RSSI_STATE="$RUNTIME_SUBDIR/rssi.last"
HEARTBEAT_MARKER="$RUNTIME_SUBDIR/presence.last"
READY_MARKER="$RUNTIME_SUBDIR/challenge-ready.last"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/syauth"
CONFIG_PATH="$CONFIG_DIR/proximity.conf"

# The phone pushes one RSSI sample every 2 s: a 2 s tick processes every
# sample exactly once and halves the loop's CPU (2026-09-26 resource
# pass: the bash loop was the heaviest item of the whole stack).
CHECK_INTERVAL_SECONDS=2
RSSI_STALE_AFTER_MS=5000
HEARTBEAT_STALE_AFTER_MS=60000
LEAVE_NEAR_LOCK_DELAY_MS=5000
BASELINE_BOOTSTRAP_SAMPLES=3
BASELINE_BOOTSTRAP_MAX_RANGE_DB=8
BASELINE_ALPHA_PERCENT=5
MID_PERSISTENCE_SECONDS=2
FAST_RETURN_CONSECUTIVE_SAMPLES=2
RETURN_SETTLING_NEAR_SAMPLES=2

DEFAULT_PROFILE="balanced"
DEFAULT_ENABLED=1
DEFAULT_LOCK_REASON="MANUAL_OR_OTHER"
LOCK_NOT_ISSUED=0
LOCK_REQUEST_PENDING=1
LOCK_OBSERVED=2
RETURN_MODE_NONE="NONE"
RETURN_MODE_PROXIMITY="PROXIMITY_RETURN"
RETURN_MODE_MANUAL_WAIT="MANUAL_WAIT_FOR_DEPARTURE"
RETURN_MODE_MANUAL_ARMED="MANUAL_ARMED_FOR_RETURN"
RETURN_MODE_SETTLING="RETURN_SETTLING"

PROFILE="$DEFAULT_PROFILE"
ENABLED="$DEFAULT_ENABLED"
BASELINE=""
ALGORITHM_VERSION=1

PROXIMITY_STATE="ABSENT"
PENDING_STATE=""
PENDING_SINCE_MS=0
BOOTSTRAP_COUNT=0
BOOTSTRAP_SUM=0
BOOTSTRAP_MIN=0
BOOTSTRAP_MAX=0
LAST_SAMPLE_MS=0
SEEN_PRESENCE=0
LOCK_REASON="$DEFAULT_LOCK_REASON"
LOCK_ISSUED=$LOCK_NOT_ISSUED
AUTO_AUTH_SENT=0
FAST_RETURN_SAMPLE_COUNT=0
FAST_RETURN_LAST_SAMPLE_MS=0
RETURN_MODE="$RETURN_MODE_NONE"
RETURN_SETTLING_NEAR_COUNT=0
RETURN_SETTLING_LAST_SAMPLE_MS=0

RSSI_RAW=""
RSSI_FILTERED=""
RSSI_SAMPLE_MS=0
RSSI_AGE_MS=0
HEARTBEAT_AGE_MS=0
STATE_CHANGED=0
LEFT_NEAR_SINCE_MS=0
NEAR_SEEN_SINCE_LOCK=1
HEARTBEAT_AGE_CACHE=-1
# loginctl is a D-Bus round trip and the tick runs every second: the session
# id never changes and a lock is noticed within a few seconds, so both
# lookups are cached. This was the heaviest CPU item of the whole stack
# (2026-09-26: ~14 s of CPU per hour for two calls per tick).
LOCK_CACHE_TICKS=3
CACHED_SID=""
CACHED_LOCKED=0
LOCKED_TICKS_LEFT=0
[[ "${SYAUTH_PROXIMITY_TEST:-0}" == 1 ]] && LOCK_CACHE_TICKS=1

log() {
    echo "syauth-proximity: $*"
}

now_ms() {
    if [[ "${SYAUTH_PROXIMITY_TEST:-0}" == 1 && -n "${SYAUTH_TEST_NOW_MS:-}" ]]; then
        printf '%s\n' "$SYAUTH_TEST_NOW_MS"
        return
    fi
    # `date +%s%3N` was one process spawn per tick; bash's EPOCHREALTIME is
    # the same clock with zero cost (LC_ALL=C is exported at the top, so the
    # decimal separator is a dot).
    local t="${EPOCHREALTIME/./}"
    printf '%s\n' "${t:0:13}"
}

profile_value() {
    local profile="$1" key="$2"
    case "$profile:$key" in
        near:far_delta) printf '%s\n' -5 ;;
        near:near_delta) printf '%s\n' -3 ;;
        near:far_persistence) printf '%s\n' 6 ;;
        near:near_persistence) printf '%s\n' 3 ;;
        near:return_delta) printf '%s\n' -2 ;;
        balanced:far_delta) printf '%s\n' -7 ;;
        balanced:near_delta) printf '%s\n' -2 ;;
        balanced:far_persistence) printf '%s\n' 8 ;;
        balanced:near_persistence) printf '%s\n' 4 ;;
        balanced:return_delta) printf '%s\n' -3 ;;
        wide:far_delta) printf '%s\n' -9 ;;
        wide:near_delta) printf '%s\n' -6 ;;
        wide:far_persistence) printf '%s\n' 10 ;;
        wide:near_persistence) printf '%s\n' 5 ;;
        wide:return_delta) printf '%s\n' -4 ;;
        *) return 1 ;;
    esac
}

profile_valid() {
    case "$1" in
        near|balanced|wide) return 0 ;;
        *) return 1 ;;
    esac
}

profile_label() {
    case "$1" in
        near) printf '%s\n' "Vicino" ;;
        balanced) printf '%s\n' "Bilanciato" ;;
        wide) printf '%s\n' "Ampio" ;;
        *) printf '%s\n' "Bilanciato" ;;
    esac
}

load_config() {
    PROFILE="$DEFAULT_PROFILE"
    ENABLED="$DEFAULT_ENABLED"
    BASELINE=""
    local legacy_peer=0

    [[ -r "$CONFIG_PATH" ]] || return 0
    while IFS='=' read -r key value; do
        case "$key" in
            profile)
                profile_valid "$value" && PROFILE="$value"
                ;;
            enabled)
                [[ "$value" == 0 || "$value" == 1 ]] && ENABLED="$value"
                ;;
            baseline)
                [[ "$value" =~ ^-?[0-9]+([.][0-9]+)?$ ]] && BASELINE="$value"
                ;;
            baseline_peer)
                legacy_peer=1
                ;;
            algorithm_version)
                [[ "$value" == "$ALGORITHM_VERSION" ]] || BASELINE=""
                ;;
        esac
    done < "$CONFIG_PATH"
    if (( legacy_peer == 1 )); then
        BASELINE=""
        save_config || true
    fi
    return 0
}

save_config() {
    mkdir -p "$CONFIG_DIR" 2>/dev/null || return 1
    chmod 700 "$CONFIG_DIR" 2>/dev/null || true
    local temp
    temp=$(mktemp "$CONFIG_DIR/.proximity.XXXXXX") || return 1
    chmod 600 "$temp" 2>/dev/null || true
    {
        printf 'algorithm_version=%s\n' "$ALGORITHM_VERSION"
        printf 'enabled=%s\n' "$ENABLED"
        printf 'profile=%s\n' "$PROFILE"
        printf 'baseline=%s\n' "$BASELINE"
    } > "$temp" || {
        rm -f "$temp"
        return 1
    }
    mv -f "$temp" "$CONFIG_PATH"
}

load_runtime() {
    PROXIMITY_STATE="ABSENT"
    PENDING_STATE=""
    PENDING_SINCE_MS=0
    BOOTSTRAP_COUNT=0
    BOOTSTRAP_SUM=0
    BOOTSTRAP_MIN=0
    BOOTSTRAP_MAX=0
    LAST_SAMPLE_MS=0
    SEEN_PRESENCE=0
    LOCK_REASON="$DEFAULT_LOCK_REASON"
    LOCK_ISSUED=$LOCK_NOT_ISSUED
    AUTO_AUTH_SENT=0
    FAST_RETURN_SAMPLE_COUNT=0
    FAST_RETURN_LAST_SAMPLE_MS=0
    RETURN_MODE="$RETURN_MODE_NONE"
    RETURN_SETTLING_NEAR_COUNT=0
    RETURN_SETTLING_LAST_SAMPLE_MS=0

    [[ -r "$RUNTIME_STATE" ]] || return 0
    while IFS='=' read -r key value; do
        case "$key" in
            state) [[ "$value" =~ ^(NEAR|MID|FAR|ABSENT)$ ]] && PROXIMITY_STATE="$value" ;;
            pending_state) [[ "$value" =~ ^(NEAR|MID|FAR|ABSENT)?$ ]] && PENDING_STATE="$value" ;;
            pending_since_ms) [[ "$value" =~ ^[0-9]+$ ]] && PENDING_SINCE_MS="$value" ;;
            bootstrap_count) [[ "$value" =~ ^[0-9]+$ ]] && BOOTSTRAP_COUNT="$value" ;;
            last_sample_ms) [[ "$value" =~ ^[0-9]+$ ]] && LAST_SAMPLE_MS="$value" ;;
            lock_issued) [[ "$value" =~ ^[0-9]+$ ]] && LOCK_ISSUED="$value" ;;
            auto_auth_sent) [[ "$value" =~ ^[0-9]+$ ]] && AUTO_AUTH_SENT="$value" ;;
            fast_return_sample_count) [[ "$value" =~ ^[0-9]+$ ]] && FAST_RETURN_SAMPLE_COUNT="$value" ;;
            fast_return_last_sample_ms) [[ "$value" =~ ^[0-9]+$ ]] && FAST_RETURN_LAST_SAMPLE_MS="$value" ;;
            return_settling_near_count) [[ "$value" =~ ^[0-9]+$ ]] && RETURN_SETTLING_NEAR_COUNT="$value" ;;
            return_settling_last_sample_ms) [[ "$value" =~ ^[0-9]+$ ]] && RETURN_SETTLING_LAST_SAMPLE_MS="$value" ;;
            return_mode)
                [[ "$value" == "$RETURN_MODE_NONE" || "$value" == "$RETURN_MODE_PROXIMITY" || "$value" == "$RETURN_MODE_MANUAL_WAIT" || "$value" == "$RETURN_MODE_MANUAL_ARMED" || "$value" == "$RETURN_MODE_SETTLING" ]] && RETURN_MODE="$value"
                ;;
            seen_presence) [[ "$value" =~ ^[0-9]+$ ]] && SEEN_PRESENCE="$value" ;;
            bootstrap_sum) [[ "$value" =~ ^-?[0-9]+([.][0-9]+)?$ ]] && BOOTSTRAP_SUM="$value" ;;
            bootstrap_min) [[ "$value" =~ ^-?[0-9]+([.][0-9]+)?$ ]] && BOOTSTRAP_MIN="$value" ;;
            bootstrap_max) [[ "$value" =~ ^-?[0-9]+([.][0-9]+)?$ ]] && BOOTSTRAP_MAX="$value" ;;
            lock_reason)
                [[ "$value" == PROXIMITY || "$value" == MANUAL_OR_OTHER ]] && LOCK_REASON="$value"
                ;;
        esac
    done < "$RUNTIME_STATE"
    return 0
}

save_runtime() {
    mkdir -p "$RUNTIME_SUBDIR" 2>/dev/null || return 1
    chmod 700 "$RUNTIME_SUBDIR" 2>/dev/null || true
    local temp
    temp=$(mktemp "$RUNTIME_SUBDIR/.proximity.state.XXXXXX") || return 1
    chmod 600 "$temp" 2>/dev/null || true
    {
        printf 'state=%s\n' "$PROXIMITY_STATE"
        printf 'pending_state=%s\n' "$PENDING_STATE"
        printf 'pending_since_ms=%s\n' "$PENDING_SINCE_MS"
        printf 'bootstrap_count=%s\n' "$BOOTSTRAP_COUNT"
        printf 'bootstrap_sum=%s\n' "$BOOTSTRAP_SUM"
        printf 'bootstrap_min=%s\n' "$BOOTSTRAP_MIN"
        printf 'bootstrap_max=%s\n' "$BOOTSTRAP_MAX"
        printf 'last_sample_ms=%s\n' "$LAST_SAMPLE_MS"
        printf 'seen_presence=%s\n' "$SEEN_PRESENCE"
        printf 'lock_reason=%s\n' "$LOCK_REASON"
        printf 'lock_issued=%s\n' "$LOCK_ISSUED"
        printf 'auto_auth_sent=%s\n' "$AUTO_AUTH_SENT"
        printf 'fast_return_sample_count=%s\n' "$FAST_RETURN_SAMPLE_COUNT"
        printf 'fast_return_last_sample_ms=%s\n' "$FAST_RETURN_LAST_SAMPLE_MS"
        printf 'return_mode=%s\n' "$RETURN_MODE"
        printf 'return_settling_near_count=%s\n' "$RETURN_SETTLING_NEAR_COUNT"
        printf 'return_settling_last_sample_ms=%s\n' "$RETURN_SETTLING_LAST_SAMPLE_MS"
    } > "$temp" || {
        rm -f "$temp"
        return 1
    }
    mv -f "$temp" "$RUNTIME_STATE"
}

marker_age_ms() {
    local path="$1"
    if [[ "${SYAUTH_PROXIMITY_TEST:-0}" == 1 && "$path" == "$HEARTBEAT_MARKER" && -n "${SYAUTH_TEST_HEARTBEAT_AGE_MS:-}" ]]; then
        printf '%s\n' "$SYAUTH_TEST_HEARTBEAT_AGE_MS"
        return
    fi
    if [[ -e "$path" ]]; then
        local seconds now
        seconds=$(stat -c %Y "$path" 2>/dev/null || echo 0)
        now=$(( $(now_ms) / 1000 ))
        (( now >= seconds )) && printf '%s\n' $(( (now - seconds) * 1000 )) || printf '%s\n' 0
    else
        printf '%s\n' 999999999
    fi
}

heartbeat_valid() {
    # The age is cached for the tick: the marker stat is a process spawn and
    # this predicate is evaluated more than once per tick. Test mode reads the
    # injected age directly — it is a plain variable, and tests flip it
    # between calls within the same tick.
    if [[ "${SYAUTH_PROXIMITY_TEST:-0}" == 1 ]]; then
        HEARTBEAT_AGE_MS="$(marker_age_ms "$HEARTBEAT_MARKER")"
        (( HEARTBEAT_AGE_MS <= HEARTBEAT_STALE_AFTER_MS ))
        return
    fi
    if (( HEARTBEAT_AGE_CACHE < 0 )); then
        HEARTBEAT_AGE_CACHE="$(marker_age_ms "$HEARTBEAT_MARKER")"
    fi
    HEARTBEAT_AGE_MS="$HEARTBEAT_AGE_CACHE"
    (( HEARTBEAT_AGE_MS <= HEARTBEAT_STALE_AFTER_MS ))
}

readiness_is_new() {
    [[ -n "$1" && "$1" != "$2" ]]
}

challenge_ready_valid() {
    if [[ "${SYAUTH_PROXIMITY_TEST:-0}" == 1 && -n "${SYAUTH_TEST_READY:-}" ]]; then
        [[ "$SYAUTH_TEST_READY" == 1 ]]
        return
    fi
    [[ -s "$READY_MARKER" ]]
}

read_rssi_sample() {
    RSSI_RAW=""
    RSSI_FILTERED=""
    RSSI_SAMPLE_MS=0
    RSSI_AGE_MS=999999999
    [[ -r "$RSSI_STATE" ]] || return 1
    local key value
    while IFS='=' read -r key value; do
        case "$key" in
            raw) RSSI_RAW="$value" ;;
            filtered) RSSI_FILTERED="$value" ;;
            sample_epoch_ms) RSSI_SAMPLE_MS="$value" ;;
        esac
    done < "$RSSI_STATE"
    [[ "$RSSI_FILTERED" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || return 1
    [[ "$RSSI_SAMPLE_MS" =~ ^[0-9]+$ ]] || return 1
    RSSI_AGE_MS=$(( $(now_ms) - RSSI_SAMPLE_MS ))
    (( RSSI_AGE_MS < 0 )) && RSSI_AGE_MS=0
    (( RSSI_AGE_MS <= RSSI_STALE_AFTER_MS ))
}

# Integer math on values scaled by 100 (two decimals). Every awk call in
# this file used to be a process spawn on a one-second loop — the single
# heaviest CPU cost of the whole stack (2026-09-26: ~14 s of CPU per hour).
# Same results, zero subprocesses.
scale100() {
    local v="$1" sign=1 int frac
    [[ "$v" == -* ]] && { sign=-1; v="${v#-}"; }
    [[ "$v" == +* ]] && v="${v#+}"
    int="${v%%.*}"
    frac="${v#*.}"
    [[ "$frac" == "$v" ]] && frac=""
    int="${int:-0}"
    frac="${frac}00"
    printf '%s' "$(( sign * (10#$int * 100 + 10#${frac:0:2}) ))"
}

unscale100() {
    local scaled="$1" sign="" value
    (( scaled < 0 )) && { sign="-"; scaled=$(( -scaled )); }
    value=$(( scaled / 100 ))
    printf '%s%s.%02d' "$sign" "$value" "$(( scaled % 100 ))"
}

rounded_div() {
    local num="$1" den="$2"
    if (( num >= 0 )); then
        printf '%s' "$(( (num + den / 2) / den ))"
    else
        printf '%s' "$(( (num - den / 2) / den ))"
    fi
}

float_add() {
    local sum
    sum=$(( $(scale100 "$1") + $(scale100 "$2") ))
    printf '%s00' "$(unscale100 "$sum")"
}

float_average() {
    local count="$2"
    (( count == 0 )) && { printf '0.00'; return; }
    unscale100 "$(rounded_div "$(scale100 "$1")" "$count")"
}

float_range() {
    printf '%s' "$(unscale100 $(( $(scale100 "$1") - $(scale100 "$2") )))"
}

float_delta() {
    float_range "$1" "$2"
}

float_ge() {
    (( $(scale100 "$1") >= $(scale100 "$2") ))
}

float_le() {
    (( $(scale100 "$1") <= $(scale100 "$2") ))
}

baseline_blend() {
    local old sample num
    old="$(scale100 "$1")"
    sample="$(scale100 "$2")"
    num=$(( old * (100 - BASELINE_ALPHA_PERCENT) + sample * BASELINE_ALPHA_PERCENT ))
    unscale100 "$(rounded_div "$num" 100)"
}

bootstrap_baseline() {
    local filtered="$1"
    if (( BOOTSTRAP_COUNT == 0 )); then
        BOOTSTRAP_MIN="$filtered"
        BOOTSTRAP_MAX="$filtered"
    else
        float_le "$filtered" "$BOOTSTRAP_MIN" && BOOTSTRAP_MIN="$filtered"
        float_ge "$filtered" "$BOOTSTRAP_MAX" && BOOTSTRAP_MAX="$filtered"
    fi
    BOOTSTRAP_SUM="$(float_add "$BOOTSTRAP_SUM" "$filtered")"
    BOOTSTRAP_COUNT=$((BOOTSTRAP_COUNT + 1))

    if (( BOOTSTRAP_COUNT < BASELINE_BOOTSTRAP_SAMPLES )); then
        return
    fi

    local range
    range="$(float_range "$BOOTSTRAP_MIN" "$BOOTSTRAP_MAX")"
    if float_le "$range" "$BASELINE_BOOTSTRAP_MAX_RANGE_DB"; then
        BASELINE="$(float_average "$BOOTSTRAP_SUM" "$BOOTSTRAP_COUNT")"
        BOOTSTRAP_COUNT=0
        BOOTSTRAP_SUM=0
        BOOTSTRAP_MIN=0
        BOOTSTRAP_MAX=0
        save_config || true
    else
        BOOTSTRAP_COUNT=1
        BOOTSTRAP_SUM="$filtered"
        BOOTSTRAP_MIN="$filtered"
        BOOTSTRAP_MAX="$filtered"
    fi
}

update_near_baseline() {
    local filtered="$1" delta="$2" near_delta
    [[ "$PROXIMITY_STATE" == NEAR ]] || return 0
    [[ "$RETURN_MODE" != "$RETURN_MODE_SETTLING" ]] || return 0
    near_delta="$(profile_value "$PROFILE" near_delta)"
    if float_ge "$delta" "$near_delta" && float_le "$delta" 0; then
        BASELINE="$(baseline_blend "$BASELINE" "$filtered")"
        save_config || true
    fi
}

candidate_state() {
    local delta="$1" far_delta near_delta
    far_delta="$(profile_value "$PROFILE" far_delta)"
    near_delta="$(profile_value "$PROFILE" near_delta)"
    if float_le "$delta" "$far_delta"; then
        printf '%s\n' FAR
    elif float_ge "$delta" "$near_delta"; then
        printf '%s\n' NEAR
    else
        printf '%s\n' MID
    fi
}

transition_persistence_ms() {
    case "$1" in
        FAR) printf '%s\n' "$(( $(profile_value "$PROFILE" far_persistence) * 1000 ))" ;;
        NEAR) printf '%s\n' "$(( $(profile_value "$PROFILE" near_persistence) * 1000 ))" ;;
        MID) printf '%s\n' "$(( MID_PERSISTENCE_SECONDS * 1000 ))" ;;
        *) printf '%s\n' 0 ;;
    esac
}

apply_candidate() {
    local candidate="$1" now="$2" required
    STATE_CHANGED=0
    if [[ "$candidate" == "$PROXIMITY_STATE" ]]; then
        PENDING_STATE=""
        PENDING_SINCE_MS=0
        return
    fi
    if [[ "$PENDING_STATE" != "$candidate" ]]; then
        PENDING_STATE="$candidate"
        PENDING_SINCE_MS="$now"
        return
    fi
    required="$(transition_persistence_ms "$candidate")"
    if (( now - PENDING_SINCE_MS < required )); then
        return
    fi
    PROXIMITY_STATE="$candidate"
    PENDING_STATE=""
    PENDING_SINCE_MS=0
    STATE_CHANGED=1
    if [[ "$candidate" == ABSENT && "$LOCK_REASON" == PROXIMITY ]]; then
        AUTO_AUTH_SENT=0
    fi
}

return_lifecycle_eligible() {
    [[ "$RETURN_MODE" == "$RETURN_MODE_PROXIMITY" || "$RETURN_MODE" == "$RETURN_MODE_SETTLING" ]] && [[ "$LOCK_REASON" == PROXIMITY ]] && return 0
    [[ "$RETURN_MODE" == "$RETURN_MODE_MANUAL_ARMED" || "$RETURN_MODE" == "$RETURN_MODE_SETTLING" ]] && [[ "$LOCK_REASON" == MANUAL_OR_OTHER ]]
}

fast_return_candidate() {
    local raw_delta return_delta
    [[ "$RSSI_SAMPLE_MS" =~ ^[0-9]+$ && "$RSSI_SAMPLE_MS" != "$FAST_RETURN_LAST_SAMPLE_MS" ]] || return 0
    FAST_RETURN_LAST_SAMPLE_MS="$RSSI_SAMPLE_MS"

    if ! return_lifecycle_eligible || [[ "$PROXIMITY_STATE" != FAR && "$PROXIMITY_STATE" != MID && ! ( "$PROXIMITY_STATE" == ABSENT && "$RETURN_MODE" == "$RETURN_MODE_MANUAL_ARMED" ) ]] || [[ -z "$BASELINE" ]] || [[ ! "$RSSI_RAW" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
        FAST_RETURN_SAMPLE_COUNT=0
        return 0
    fi

    return_delta="$(profile_value "$PROFILE" return_delta)"
    raw_delta="$(float_delta "$RSSI_RAW" "$BASELINE")"
    if float_ge "$raw_delta" "$return_delta"; then
        FAST_RETURN_SAMPLE_COUNT=$((FAST_RETURN_SAMPLE_COUNT + 1))
        log "fast return candidate ${FAST_RETURN_SAMPLE_COUNT}/${FAST_RETURN_CONSECUTIVE_SAMPLES}"
    else
        FAST_RETURN_SAMPLE_COUNT=0
        return 0
    fi

    if (( FAST_RETURN_SAMPLE_COUNT >= FAST_RETURN_CONSECUTIVE_SAMPLES )); then
        PROXIMITY_STATE=NEAR
        PENDING_STATE=""
        PENDING_SINCE_MS=0
        STATE_CHANGED=1
        FAST_RETURN_SAMPLE_COUNT=0
        RETURN_MODE="$RETURN_MODE_SETTLING"
        RETURN_SETTLING_NEAR_COUNT=0
        RETURN_SETTLING_LAST_SAMPLE_MS=0
        log "fast return confirmed"
        log "return settling entered"
    fi
}

update_return_settling() {
    local candidate="$1"
    [[ "$RETURN_MODE" == "$RETURN_MODE_SETTLING" ]] || return 1
    PENDING_STATE=""
    PENDING_SINCE_MS=0
    if [[ "$candidate" == NEAR && "$RSSI_SAMPLE_MS" != "$RETURN_SETTLING_LAST_SAMPLE_MS" ]]; then
        RETURN_SETTLING_LAST_SAMPLE_MS="$RSSI_SAMPLE_MS"
        RETURN_SETTLING_NEAR_COUNT=$((RETURN_SETTLING_NEAR_COUNT + 1))
    elif [[ "$candidate" != NEAR ]]; then
        RETURN_SETTLING_NEAR_COUNT=0
        RETURN_SETTLING_LAST_SAMPLE_MS=0
    fi
    if (( RETURN_SETTLING_NEAR_COUNT >= RETURN_SETTLING_NEAR_SAMPLES )); then
        RETURN_MODE="$RETURN_MODE_NONE"
        RETURN_SETTLING_NEAR_COUNT=0
        RETURN_SETTLING_LAST_SAMPLE_MS=0
        log "return settling complete"
    fi
    return 0
}

process_rssi() {
    local now="$1" delta candidate
    STATE_CHANGED=0
    read_rssi_sample || return 0
    (( RSSI_SAMPLE_MS <= LAST_SAMPLE_MS )) && return 0
    LAST_SAMPLE_MS="$RSSI_SAMPLE_MS"

    if [[ -z "$BASELINE" ]]; then
        bootstrap_baseline "$RSSI_FILTERED"
        PROXIMITY_STATE="NEAR"
        PENDING_STATE=""
        PENDING_SINCE_MS=0
        return
    fi

    delta="$(float_delta "$RSSI_FILTERED" "$BASELINE")"
    candidate="$(candidate_state "$delta")"
    [[ "$candidate" == NEAR && "$PROXIMITY_STATE" == NEAR ]] && update_near_baseline "$RSSI_FILTERED" "$delta"
    if update_return_settling "$candidate"; then
        return 0
    fi
    apply_candidate "$candidate" "$now"
}

session_id() {
    local user_name="${USER:-$(id -un)}"
    loginctl show-user "$user_name" -p Display --value 2>/dev/null | head -n1
}

session_is_locked() {
    local sid="$1"
    [[ "$(loginctl show-session "$sid" -p LockedHint --value 2>/dev/null)" == yes ]]
}

lock_session() {
    local sid="$1"
    if [[ "${SYAUTH_PROXIMITY_TEST:-0}" == 1 ]]; then
        printf 'LOCK\n' >> "${SYAUTH_TEST_ACTION_LOG:?}"
        SYAUTH_TEST_LOCKED=1
        return 0
    fi
    loginctl lock-session "$sid"
}

request_auto_auth() {
    if [[ "${SYAUTH_PROXIMITY_TEST:-0}" == 1 ]]; then
        printf 'AUTH\n' >> "${SYAUTH_TEST_ACTION_LOG:?}"
        return "${SYAUTH_TEST_AUTH_RC:-0}"
    fi
    command -v dms >/dev/null 2>&1 || return 1
    dms ipc call syauth phoneReturned >/dev/null 2>&1
}

mark_manual_lock() {
    [[ "$LOCK_REASON" == PROXIMITY || "$RETURN_MODE" == "$RETURN_MODE_SETTLING" || "$RETURN_MODE" == "$RETURN_MODE_MANUAL_ARMED" ]] && return 0
    LOCK_REASON=MANUAL_OR_OTHER
    LOCK_ISSUED=$LOCK_NOT_ISSUED
    AUTO_AUTH_SENT=0
    FAST_RETURN_SAMPLE_COUNT=0
    if [[ "$PROXIMITY_STATE" == FAR || "$PROXIMITY_STATE" == ABSENT ]]; then
        if [[ "$RETURN_MODE" != "$RETURN_MODE_MANUAL_ARMED" ]]; then
            RETURN_MODE="$RETURN_MODE_MANUAL_ARMED"
            log "manual return armed"
        fi
    elif [[ "$RETURN_MODE" != "$RETURN_MODE_MANUAL_WAIT" ]]; then
        RETURN_MODE="$RETURN_MODE_MANUAL_WAIT"
        log "manual lock waiting for departure"
    fi
}

arm_manual_return_if_departed() {
    [[ "$LOCK_REASON" == MANUAL_OR_OTHER ]] || return 0
    [[ "$RETURN_MODE" == "$RETURN_MODE_MANUAL_WAIT" ]] || return 0
    if [[ "$PROXIMITY_STATE" == FAR || "$PROXIMITY_STATE" == ABSENT ]]; then
        RETURN_MODE="$RETURN_MODE_MANUAL_ARMED"
        FAST_RETURN_SAMPLE_COUNT=0
        log "manual return armed"
    fi
    return 0
}

request_proximity_lock() {
    local sid="$1"
    (( LOCK_ISSUED == LOCK_REQUEST_PENDING || LOCK_ISSUED == LOCK_OBSERVED )) && return
    if lock_session "$sid"; then
        LOCK_ISSUED=$LOCK_REQUEST_PENDING
        LOCK_REASON=PROXIMITY
        AUTO_AUTH_SENT=0
        FAST_RETURN_SAMPLE_COUNT=0
        NEAR_SEEN_SINCE_LOCK=0
        RETURN_MODE="$RETURN_MODE_PROXIMITY"
        log "proximity lock requested state=$PROXIMITY_STATE"
    fi
}

maybe_auto_auth() {
    [[ "$PROXIMITY_STATE" == NEAR ]] || return
    return_lifecycle_eligible || return
    (( AUTO_AUTH_SENT == 0 )) || return
    heartbeat_valid || return
    challenge_ready_valid || return
    AUTO_AUTH_SENT=1
    if request_auto_auth; then
        log "proximity return biometric request sent"
    else
        log "proximity return biometric request failed"
    fi
}

engine_initialize() {
    load_config
    load_runtime
    # One-lock-per-departure bookkeeping lives in process memory only: a
    # restart re-arms the watcher (the runtime file carries the state, not
    # the countdown).
    LEFT_NEAR_SINCE_MS=0
    NEAR_SEEN_SINCE_LOCK=1
    if [[ "$PROXIMITY_STATE" == FAR && "$LOCK_ISSUED" == "$LOCK_NOT_ISSUED" ]]; then
        PROXIMITY_STATE=MID
        PENDING_STATE=""
        PENDING_SINCE_MS=0
    fi
    if heartbeat_valid; then
        SEEN_PRESENCE=1
    else
        SEEN_PRESENCE=0
    fi
    local sid
    sid="$(session_id)"
    if [[ -n "$sid" ]] && session_is_locked "$sid"; then
        [[ "$LOCK_REASON" == PROXIMITY && "$LOCK_ISSUED" == "$LOCK_REQUEST_PENDING" ]] && LOCK_ISSUED=$LOCK_OBSERVED
        if [[ "$LOCK_REASON" == PROXIMITY && "$PROXIMITY_STATE" == NEAR ]]; then
            AUTO_AUTH_SENT=1
        fi
    fi
    save_runtime || true
}

engine_tick() {
    load_config
    load_runtime
    HEARTBEAT_AGE_CACHE=-1
    local now sid locked
    now="$(now_ms)"
    if [[ -z "$CACHED_SID" ]]; then
        CACHED_SID="$(session_id)"
    fi
    sid="$CACHED_SID"
    if (( LOCKED_TICKS_LEFT <= 0 )); then
        if [[ -n "$sid" ]] && session_is_locked "$sid"; then
            CACHED_LOCKED=1
        else
            CACHED_LOCKED=0
        fi
        LOCKED_TICKS_LEFT=$LOCK_CACHE_TICKS
    fi
    (( LOCKED_TICKS_LEFT-- ))
    locked=$CACHED_LOCKED
    if (( locked == 1 )); then
        [[ "$LOCK_REASON" == PROXIMITY && "$LOCK_ISSUED" == "$LOCK_REQUEST_PENDING" ]] && LOCK_ISSUED=$LOCK_OBSERVED
    elif [[ "$RETURN_MODE" == "$RETURN_MODE_SETTLING" ]]; then
        : # preserve return settling until fresh RSSI re-synchronizes the model.
    elif [[ "$LOCK_REASON" == PROXIMITY && "$LOCK_ISSUED" == "$LOCK_REQUEST_PENDING" ]]; then
        : # loginctl may expose the new lock on the next tick; retain provenance.
    else
        LOCK_REASON=MANUAL_OR_OTHER
        LOCK_ISSUED=$LOCK_NOT_ISSUED
        AUTO_AUTH_SENT=0
        FAST_RETURN_SAMPLE_COUNT=0
        RETURN_MODE="$RETURN_MODE_NONE"
        RETURN_SETTLING_NEAR_COUNT=0
        RETURN_SETTLING_LAST_SAMPLE_MS=0
    fi

    if (( ENABLED == 0 )); then
        save_runtime || true
        return
    fi

    if ! heartbeat_valid; then
        if [[ "$RETURN_MODE" == "$RETURN_MODE_SETTLING" ]]; then
            RETURN_MODE="$RETURN_MODE_NONE"
            RETURN_SETTLING_NEAR_COUNT=0
            RETURN_SETTLING_LAST_SAMPLE_MS=0
            log "return settling cancelled by lost presence"
        fi
        if [[ "$LOCK_REASON" == PROXIMITY && ( "$PROXIMITY_STATE" == FAR || "$PROXIMITY_STATE" == MID ) ]]; then
            process_rssi "$now"
            fast_return_candidate
            if [[ "$PROXIMITY_STATE" == NEAR || "$FAST_RETURN_SAMPLE_COUNT" -gt 0 ]]; then
                save_runtime || true
                return
            fi
        fi
        if (( SEEN_PRESENCE == 1 )); then
            local departed=0
            if [[ "$PROXIMITY_STATE" != ABSENT ]]; then
                PROXIMITY_STATE=ABSENT
                PENDING_STATE=""
                PENDING_SINCE_MS=0
                STATE_CHANGED=1
                departed=1
                [[ "$LOCK_REASON" == PROXIMITY ]] && AUTO_AUTH_SENT=0
            fi
            # One lock per departure: lock when the phone is *observed* going
            # away, never again while it stays away. Re-locking on the level
            # state undid the operator's unlock on the next tick (hardware run
            # 2026-09-23: lock -> unlock -> lock 1 s later), a lock-screen loop
            # that risks locking the operator out for good.
            if (( locked == 0 )) && [[ -n "$sid" ]] && (( departed == 1 )); then
                request_proximity_lock "$sid"
            fi
        else
            PROXIMITY_STATE=ABSENT
        fi
        if (( locked == 1 )); then
            arm_manual_return_if_departed
        fi
        save_runtime || true
        return
    fi

    SEEN_PRESENCE=1
    process_rssi "$now"
    fast_return_candidate

    # Leaving NEAR arms a short countdown: the operator asked the lock to fire
    # 5 s after the state leaves NEAR (2026-09-24), not only at FAR or after a
    # full disconnect. The countdown resets on any NEAR candidate so a quick
    # walk to the next room that comes straight back does not lock.
    if [[ "$PROXIMITY_STATE" == NEAR ]]; then
        NEAR_SEEN_SINCE_LOCK=1
        LEFT_NEAR_SINCE_MS=0
    elif [[ "$PENDING_STATE" == NEAR ]]; then
        LEFT_NEAR_SINCE_MS=0
    elif (( LEFT_NEAR_SINCE_MS == 0 )); then
        LEFT_NEAR_SINCE_MS="$now"
    fi

    if (( locked == 0 )); then
        if (( NEAR_SEEN_SINCE_LOCK == 1 )) && [[ "$RETURN_MODE" != "$RETURN_MODE_SETTLING" && -n "$sid" ]]; then
            if [[ "$PROXIMITY_STATE" == MID || "$PROXIMITY_STATE" == FAR ]] && (( LEFT_NEAR_SINCE_MS > 0 )) && (( now - LEFT_NEAR_SINCE_MS >= LEAVE_NEAR_LOCK_DELAY_MS )); then
                request_proximity_lock "$sid"
            fi
        fi
    else
        if [[ "$LOCK_REASON" != PROXIMITY ]]; then
            mark_manual_lock
            arm_manual_return_if_departed
            return_lifecycle_eligible && maybe_auto_auth || true
        else
            maybe_auto_auth || true
        fi
    fi
    save_runtime || true
}

status_cmd() {
    load_config
    load_runtime
    local baseline_ready=no
    [[ -n "$BASELINE" ]] && baseline_ready=yes
    printf 'enabled=%s\n' "$ENABLED"
    printf 'state=%s\n' "$PROXIMITY_STATE"
    printf 'profile=%s\n' "$(profile_label "$PROFILE")"
    printf 'profile_id=%s\n' "$PROFILE"
    printf 'baseline_ready=%s\n' "$baseline_ready"
    printf 'lock_reason=%s\n' "$LOCK_REASON"
}

diagnostics_cmd() {
    load_config
    load_runtime
    read_rssi_sample || true
    HEARTBEAT_AGE_MS="$(marker_age_ms "$HEARTBEAT_MARKER")"
    local delta="n/a"
    if [[ -n "$BASELINE" && -n "$RSSI_FILTERED" ]]; then
        delta="$(float_delta "$RSSI_FILTERED" "$BASELINE")"
    fi
    printf 'RSSI raw: %s dBm\n' "${RSSI_RAW:-n/a}"
    printf 'RSSI filtered: %s dBm\n' "${RSSI_FILTERED:-n/a}"
    printf 'baseline: %s\n' "${BASELINE:-n/a}"
    printf 'delta: %s dB\n' "$delta"
    printf 'sample age: %s ms\n' "$RSSI_AGE_MS"
    printf 'proximity state: %s\n' "$PROXIMITY_STATE"
    printf 'heartbeat age: %s ms\n' "$HEARTBEAT_AGE_MS"
    printf 'challenge-ready: %s\n' "$(challenge_ready_valid && echo yes || echo no)"
    printf 'lock reason: %s\n' "$LOCK_REASON"
    printf 'return mode: %s\n' "$RETURN_MODE"
    printf 'fast-return streak: %s/%s\n' "$FAST_RETURN_SAMPLE_COUNT" "$FAST_RETURN_CONSECUTIVE_SAMPLES"
    printf 'return settling: %s\n' "$( [[ "$RETURN_MODE" == "$RETURN_MODE_SETTLING" ]] && echo yes || echo no )"
    printf 'manual return armed: %s\n' "$( [[ "$RETURN_MODE" == "$RETURN_MODE_MANUAL_ARMED" ]] && echo yes || echo no )"
}

set_profile_cmd() {
    local profile="${1:-}"
    profile_valid "$profile" || {
        echo "Profilo non valido: $profile" >&2
        return 2
    }
    load_config
    PROFILE="$profile"
    save_config
}

set_enabled_cmd() {
    local enabled="$1"
    [[ "$enabled" == 0 || "$enabled" == 1 ]] || return 2
    load_config
    ENABLED="$enabled"
    save_config
    [[ "${SYAUTH_PROXIMITY_TEST:-0}" == 1 ]] && return 0
    if (( enabled == 1 )); then
        systemctl --user start syauth-proximity.service
    else
        systemctl --user stop syauth-proximity.service
    fi
}

reset_cmd() {
    load_config
    BASELINE=""
    save_config
    rm -f "$RUNTIME_STATE"
}

if [[ "${SYAUTH_PROXIMITY_TEST:-0}" == 1 ]]; then
    return 0 2>/dev/null || exit 0
fi

case "${1:-run}" in
    run)
        engine_initialize
        while sleep "$CHECK_INTERVAL_SECONDS"; do
            engine_tick
        done
        ;;
    status)
        status_cmd
        ;;
    diagnostics)
        diagnostics_cmd
        ;;
    profile)
        if [[ $# -eq 1 ]]; then
            load_config
            printf '%s\n' "$PROFILE"
        else
            set_profile_cmd "$2"
        fi
        ;;
    enable)
        set_enabled_cmd 1
        ;;
    disable)
        set_enabled_cmd 0
        ;;
    reset)
        reset_cmd
        ;;
    *)
        echo "Uso: syauth-proximity {run|status|diagnostics|profile [near|balanced|wide]|enable|disable|reset}" >&2
        exit 64
        ;;
esac
