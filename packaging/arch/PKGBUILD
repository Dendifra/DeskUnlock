pkgname=deskunlock
pkgver=0.1.0
pkgrel=18
provides=('syauth-suite=0.1.0')
conflicts=('syauth-suite')
replaces=('syauth-suite')
pkgdesc='Phone-assisted Linux authentication with PAM fallback'
arch=('x86_64')
license=('MIT')
depends=('bash' 'bluez' 'bluez-utils' 'dbus' 'dms-shell' 'pam' 'polkit' 'pyside6' 'python' 'systemd' 'wayland')
makedepends=('cargo' 'go' 'git' 'wayland')
source=()
install=deskunlock.install

build() {
    cd "$startdir/../.."
    RUSTFLAGS="-C debuginfo=0 --remap-path-prefix=${HOME}=/usr/src" cargo build --release --workspace
    desktop/dms/build-dms-syauth.sh "$srcdir/dms-syauth"
    wayland-scanner client-header desktop/wayland/ext-idle-notify-v1.xml "$srcdir/ext-idle-notify-v1-client-protocol.h"
    wayland-scanner private-code desktop/wayland/ext-idle-notify-v1.xml "$srcdir/ext-idle-notify-v1-client-protocol.c"
    cc -std=c11 -O2 -Wall -Wextra -Werror \
        -I"$srcdir" desktop/wayland/syauth-idle-lock.c \
        "$srcdir/ext-idle-notify-v1-client-protocol.c" \
        $(pkg-config --cflags --libs wayland-client) \
        -o "$srcdir/syauth-idle-lock-bin"
}

package() {
    cd "$startdir/../.."

    install -Dm755 target/release/syauth "$pkgdir/usr/bin/syauth"
    install -Dm755 target/release/syauth-presenced "$pkgdir/usr/lib/syauth/syauth-presenced"
    install -Dm644 target/release/libpam_syauth.so "$pkgdir/usr/lib/security/pam_syauth.so"
    install -Dm755 "$srcdir/dms-syauth" "$pkgdir/usr/bin/dms-syauth"
    install -Dm755 "$srcdir/syauth-idle-lock-bin" \
        "$pkgdir/usr/lib/syauth/syauth-idle-lock-bin"

    for file in desktop/bin/*; do
        install -Dm755 "$file" "$pkgdir/usr/bin/$(basename "$file")"
    done
    for file in desktop/libexec/*; do
        install -Dm755 "$file" "$pkgdir/usr/lib/syauth/$(basename "$file")"
    done
    for file in desktop/systemd/*.service desktop/systemd/*.timer desktop/systemd/*.path; do
        install -Dm644 "$file" "$pkgdir/usr/lib/systemd/user/$(basename "$file")"
    done
    install -Dm644 desktop/systemd/dms.service.d/syauth.conf \
        "$pkgdir/usr/lib/systemd/user/dms.service.d/syauth.conf"
    install -Dm644 desktop/pam/syauth-dms "$pkgdir/etc/pam.d/syauth-dms"
    install -Dm644 desktop/hooks/syauth-pam.hook \
        "$pkgdir/usr/share/libalpm/hooks/syauth-pam.hook"
    install -Dm644 desktop/applications/syauth.desktop \
        "$pkgdir/usr/share/applications/syauth.desktop"
    install -Dm644 assets/deskunlock-logo.png \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/deskunlock.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 docs/security.md "$pkgdir/usr/share/doc/$pkgname/security.md"
    install -Dm644 docs/packaging.md "$pkgdir/usr/share/doc/$pkgname/packaging.md"
}
