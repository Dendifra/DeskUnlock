#!/usr/bin/env python3
import shutil
import subprocess
import sys
import time

time.sleep(1)

syauth = shutil.which("syauth")

if not syauth:
    print("syauth-reconcile: syauth non trovato", file=sys.stderr)
    sys.exit(1)

r = subprocess.run(
    [syauth, "list"],
    text=True,
    capture_output=True,
)

if r.returncode != 0:
    print(
        "syauth-reconcile: list failed: " + r.stderr.strip(),
        file=sys.stderr,
    )
    sys.exit(1)

bonded = []

for line in r.stdout.splitlines():
    parts = line.split()

    if len(parts) < 3:
        continue

    peer_id = parts[0]
    created_at = parts[-1]

    if "bonded" in parts[1:-1]:
        bonded.append((created_at, peer_id))

if len(bonded) <= 1:
    print("syauth-reconcile: alignment ok")
    sys.exit(0)

bonded.sort()

keep_created, keep_peer = bonded[-1]

print(
    "syauth-reconcile: keeping newest peer="
    + keep_peer
    + " created="
    + keep_created
)

for created_at, peer_id in bonded[:-1]:
    print(
        "syauth-reconcile: revoking stale peer="
        + peer_id
        + " created="
        + created_at
    )

    subprocess.run(
        [
            syauth,
            "revoke",
            "--id",
            peer_id,
            "--reason",
            "superseded-by-newer-pair",
        ],
        check=True,
    )

print("syauth-reconcile: alignment complete")
