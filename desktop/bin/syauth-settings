#!/usr/bin/env python3

import re
import subprocess
import sys
import time
from pathlib import Path

from PySide6.QtCore import Qt, QTimer, QProcess
from PySide6.QtGui import QFont, QIcon
from PySide6.QtWidgets import (
    QApplication,
    QCheckBox,
    QComboBox,
    QDialog,
    QFrame,
    QHBoxLayout,
    QLabel,
    QMainWindow,
    QMessageBox,
    QPushButton,
    QSpinBox,
    QVBoxLayout,
    QWidget,
)


HOME = Path.home()
CONTROL = Path("/usr/bin/syauth-control")
DEVICE_CONTROL = Path("/usr/bin/syauth-device")
PROXIMITY_CONTROL = Path("/usr/bin/syauth-proximity")
IDLE_CONTROL = Path("/usr/bin/syauth-idle-lock")
PRESENCE_MARKER = Path("/run/syauth/presence.last")
DESKUNLOCK_LOGO = Path("/usr/share/icons/hicolor/256x256/apps/deskunlock.png")


def deskunlock_icon():
    icon = QIcon(str(DESKUNLOCK_LOGO))
    return icon if not icon.isNull() else QIcon.fromTheme("security-high")


def run_command(command, timeout=2):
    try:
        result = subprocess.run(
            command,
            text=True,
            capture_output=True,
            timeout=timeout,
            check=False,
        )
        return result.stdout.strip()
    except Exception:
        return ""


def get_master_state():
    output = run_command([str(CONTROL), "status"])

    if "Syauth: ON" in output:
        return "on"

    if "Syauth: OFF" in output:
        return "off"

    return "degraded"


def get_syauth_state():
    status = run_command(["syauth", "status"])
    bonds = run_command(["syauth", "list"])

    daemon_up = "daemon=up" in status
    bluetooth_ready = (
        "adapter-state:" in status
        and "Powered" in status
    )

    bonded = 0
    revoked = 0

    for line in bonds.splitlines():
        if re.search(r"\bbonded\b", line):
            bonded += 1

        if re.search(r"\brevoked", line):
            revoked += 1

    last_unlock = "Mai"

    match = re.search(r"last-unlock:\s+(.+)", status)

    if match:
        raw = match.group(1).strip()

        if raw and raw != "never":
            last_unlock = raw.split("  ")[0]

            try:
                value = last_unlock.rstrip("Z")
                date_part, time_part = value.split("T", 1)

                year, month, day = date_part.split("-")
                hour, minute = time_part.split(":")[:2]

                last_unlock = (
                    f"{day}/{month}/{year} "
                    f"{hour}:{minute}"
                )
            except Exception:
                pass

    return {
        "daemon": daemon_up,
        "bluetooth": bluetooth_ready,
        "bonded": bonded,
        "revoked": revoked,
        "last_unlock": last_unlock,
    }


def get_proximity_diagnostics():
    output = run_command([str(PROXIMITY_CONTROL), "diagnostics"])
    values = {}
    for line in output.splitlines():
        key, separator, value = line.partition(": ")
        if separator:
            values[key.lower()] = value
    return values


def get_idle_settings():
    output = run_command([str(IDLE_CONTROL), "status"])
    values = {}
    for line in output.splitlines():
        key, separator, value = line.partition("=")
        if separator:
            values[key] = value
    try:
        minutes = int(values.get("idle_lock_minutes", "10"))
    except ValueError:
        minutes = 10
    return {
        "available": bool(output),
        "enabled": values.get("idle_lock_enabled", "1") == "1",
        "minutes": max(1, min(120, minutes)),
    }


def restart_idle_service():
    run_command(["systemctl", "--user", "restart", "syauth-idle-lock.service"])


def get_proximity_state():
    output = run_command([str(PROXIMITY_CONTROL), "status"])
    if not output:
        return {
            "available": False,
            "enabled": False,
            "state": "ABSENT",
            "profile_id": "balanced",
        }

    values = {}
    for line in output.splitlines():
        key, separator, value = line.partition("=")
        if separator:
            values[key] = value

    return {
        "available": True,
        "enabled": values.get("enabled") == "1",
        "state": values.get("state", "ABSENT"),
        "profile_id": values.get("profile_id", "balanced"),
    }


def get_phone_info():
    output = run_command(
        ["bluetoothctl", "devices", "Bonded"]
    )

    for line in output.splitlines():
        parts = line.split(maxsplit=2)

        if len(parts) != 3:
            continue

        address = parts[1]
        name = parts[2].strip()

        if "pixel" not in name.lower():
            continue

        info = run_command(
            ["bluetoothctl", "info", address]
        )

        connected = "Connected: yes" in info
        paired = (
            "Paired: yes" in info
            and "Bonded: yes" in info
        )

        return {
            "name": name,
            "connected": connected,
            "paired": paired,
        }

    return {
        "name": "Telefono associato",
        "connected": False,
        "paired": False,
    }


class StatusDot(QLabel):
    def __init__(self):
        super().__init__("●")
        self.setFixedWidth(18)

    def set_state(self, good):
        if good:
            self.setStyleSheet(
                "color: #63c174;"
                "font-size: 16px;"
            )
        else:
            self.setStyleSheet(
                "color: #8b929a;"
                "font-size: 16px;"
            )


class StatusRow(QWidget):
    def __init__(self, title):
        super().__init__()

        self.dot = StatusDot()

        self.title = QLabel(title)

        self.value = QLabel("")
        self.value.setAlignment(
            Qt.AlignmentFlag.AlignRight
            | Qt.AlignmentFlag.AlignVCenter
        )
        self.value.setStyleSheet(
            "color: #aeb4bc;"
        )

        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 4, 0, 4)
        layout.setSpacing(7)

        layout.addWidget(self.dot)
        layout.addWidget(self.title)
        layout.addStretch()
        layout.addWidget(self.value)

    def set_status(self, good, text):
        self.dot.set_state(good)
        self.value.setText(text)


class SettingsWindow(QMainWindow):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("DeskUnlock")
        self.setMinimumWidth(520)
        self.setMaximumWidth(620)

        icon = deskunlock_icon()

        if not icon.isNull():
            self.setWindowIcon(icon)

        self.busy = False
        self.process = None
        self.command_process = None
        self.command_title = ""

        root = QWidget()
        self.setCentralWidget(root)

        main = QVBoxLayout(root)
        main.setContentsMargins(28, 24, 28, 24)
        main.setSpacing(16)

        self.build_header(main)
        self.build_master(main)
        self.build_device(main)
        self.build_proximity(main)
        self.build_idle_lock(main)
        self.build_features(main)
        self.build_system_status(main)

        main.addStretch()

        footer = QHBoxLayout()
        footer.addStretch()

        close_button = QPushButton("Chiudi")
        close_button.setMinimumWidth(95)
        close_button.clicked.connect(self.close)

        footer.addWidget(close_button)

        main.addLayout(footer)

        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(2000)

        self.refresh()

        self.adjustSize()
        self.resize(
            max(self.width(), 540),
            min(self.height(), 760),
        )

    def section_title(self, text):
        label = QLabel(text)
        label.setStyleSheet(
            "font-size: 11px;"
            "font-weight: 600;"
            "color: #aeb4bc;"
        )
        return label

    def card(self):
        frame = QFrame()
        frame.setFrameShape(QFrame.Shape.StyledPanel)
        return frame

    def build_header(self, main):
        header = QHBoxLayout()

        icon_label = QLabel()

        icon = deskunlock_icon()

        if not icon.isNull():
            icon_label.setPixmap(
                icon.pixmap(46, 46)
            )

        titles = QVBoxLayout()
        titles.setSpacing(1)

        title = QLabel("DeskUnlock")

        font = QFont()
        font.setPointSize(19)
        font.setBold(True)

        title.setFont(font)

        subtitle = QLabel(
            "Autenticazione sicura con il telefono"
        )
        subtitle.setStyleSheet(
            "color: #aeb4bc;"
        )

        titles.addWidget(title)
        titles.addWidget(subtitle)

        header.addWidget(icon_label)
        header.addSpacing(10)
        header.addLayout(titles)
        header.addStretch()

        main.addLayout(header)

