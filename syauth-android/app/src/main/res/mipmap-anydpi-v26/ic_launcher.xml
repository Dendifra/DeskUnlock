<?xml version="1.0" encoding="utf-8"?>
<!--
  DeskUnlock adaptive launcher icon, API 26+.

  Foreground uses the canonical project logo from
  `assets/deskunlock-logo.png`, mirrored into
  `res/drawable-nodpi/deskunlock_logo.png`.

  Background stays the pure-black colour from
  `values/ic_launcher_background.xml` so the transparent logo remains
  legible across launcher mask shapes.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/deskunlock_logo"/>
</adaptive-icon>
