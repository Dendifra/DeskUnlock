    def build_idle_lock(self, main):
        main.addWidget(self.section_title("INATTIVITÀ"))

        card = self.card()
        layout = QVBoxLayout(card)
        layout.setContentsMargins(18, 14, 18, 14)
        layout.setSpacing(10)

        header = QHBoxLayout()
        text = QVBoxLayout()
        text.setSpacing(2)
        title = QLabel("Blocco per inattività")
        font = title.font()
        font.setBold(True)
        font.setPointSize(11)
        title.setFont(font)
        description = QLabel("Blocca il PC dopo un periodo senza attività")
        description.setStyleSheet("color: #aeb4bc;")
        text.addWidget(title)
        text.addWidget(description)
        header.addLayout(text)
        header.addStretch()
        self.idle_toggle = QCheckBox("Attivo")
        self.idle_toggle.toggled.connect(self.set_idle_enabled)
        header.addWidget(self.idle_toggle)
        layout.addLayout(header)

        timeout_row = QHBoxLayout()
        timeout_row.addWidget(QLabel("Blocca dopo"))
        timeout_row.addStretch()
        self.idle_minutes = QSpinBox()
        self.idle_minutes.setRange(1, 120)
        self.idle_minutes.setSuffix(" minuti")
        self.idle_minutes.valueChanged.connect(self.set_idle_minutes)
        timeout_row.addWidget(self.idle_minutes)
        layout.addLayout(timeout_row)
        main.addWidget(card)

    def set_idle_enabled(self, enabled):
        run_command([str(IDLE_CONTROL), "enable" if enabled else "disable"])
        restart_idle_service()
        self.refresh()

    def set_idle_minutes(self, minutes):
        if self.idle_minutes.isEnabled():
            run_command([str(IDLE_CONTROL), "minutes", str(minutes)])
            restart_idle_service()
        self.refresh()

    def set_proximity_enabled(self, enabled):
        action = "enable" if enabled else "disable"
        run_command([str(PROXIMITY_CONTROL), action])
        self.refresh()

    def set_proximity_profile(self, index):
        profile = self.proximity_profile.itemData(index)
        if profile:
            run_command([str(PROXIMITY_CONTROL), "profile", profile])
        self.refresh()

    def show_proximity_diagnostics(self):
        values = get_proximity_diagnostics()
        dialog = QDialog(self)
        dialog.setWindowTitle("Diagnostica avanzata")
        dialog.setMinimumWidth(430)

        layout = QVBoxLayout(dialog)
        layout.setContentsMargins(24, 22, 24, 18)
        layout.setSpacing(14)
        layout.addWidget(self.section_title("DIAGNOSTICA AVANZATA"))

        card = self.card()
        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(18, 12, 18, 12)
        card_layout.setSpacing(1)

        fields = (
            ("RSSI raw", "rssi raw"),
            ("RSSI filtered", "rssi filtered"),
            ("Baseline", "baseline"),
            ("Delta", "delta"),
            ("Sample age", "sample age"),
            ("Proximity state", "proximity state"),
            ("Heartbeat age", "heartbeat age"),
            ("GATT ready", "challenge-ready"),
            ("Lock reason", "lock reason"),
        )
        for label, key in fields:
            row = QHBoxLayout()
            row.setContentsMargins(0, 4, 0, 4)
            row.addWidget(QLabel(label))
            row.addStretch()
            value = QLabel(values.get(key, "n/a"))
            value.setStyleSheet("color: #aeb4bc;")
            row.addWidget(value)
            card_layout.addLayout(row)

        layout.addWidget(card)
        close_button = QPushButton("Chiudi")
        close_button.setMinimumWidth(95)
        close_button.clicked.connect(dialog.accept)
        buttons = QHBoxLayout()
        buttons.addStretch()
        buttons.addWidget(close_button)
        layout.addLayout(buttons)
        dialog.exec()

    def build_features(self, main):
        main.addWidget(
            self.section_title(
                "UTILIZZATO PER"
            )
        )

        card = self.card()

        layout = QVBoxLayout(card)
        layout.setContentsMargins(18, 12, 18, 12)
        layout.setSpacing(8)

        features = (
            "✓  Login e sblocco della sessione",
            "✓  Conferma biometrica sul telefono",
            "✓  Blocco automatico per allontanamento",
            "✓  Password Linux disponibile come fallback",
        )

        for feature in features:
            layout.addWidget(QLabel(feature))

        main.addWidget(card)

    def build_system_status(self, main):
        main.addWidget(
            self.section_title(
                "STATO SISTEMA"
            )
        )

        card = self.card()

        layout = QVBoxLayout(card)
        layout.setContentsMargins(18, 10, 18, 10)
        layout.setSpacing(1)

        self.daemon_row = StatusRow(
            "Servizio DeskUnlock"
        )

        self.bluetooth_row = StatusRow(
            "Bluetooth"
        )

        self.bond_row = StatusRow(
            "Associazione"
        )

        self.unlock_row = StatusRow(
            "Ultimo sblocco"
        )

        for row in (
            self.daemon_row,
            self.bluetooth_row,
            self.bond_row,
            self.unlock_row,
        ):
            layout.addWidget(row)

        main.addWidget(card)

    def refresh(self):
        master = get_master_state()
        data = get_syauth_state()
        proximity = get_proximity_state()
        idle = get_idle_settings()

        self.idle_toggle.blockSignals(True)
        self.idle_toggle.setChecked(idle["enabled"])
        self.idle_toggle.blockSignals(False)
        self.idle_minutes.blockSignals(True)
        self.idle_minutes.setValue(idle["minutes"])
        self.idle_minutes.setEnabled(idle["enabled"])
        self.idle_minutes.blockSignals(False)

        self.proximity_toggle.blockSignals(True)
        self.proximity_toggle.setChecked(proximity["enabled"])
        self.proximity_toggle.blockSignals(False)

        self.proximity_profile.blockSignals(True)
        profile_index = self.proximity_profile.findData(
            proximity["profile_id"]
        )
        if profile_index >= 0:
            self.proximity_profile.setCurrentIndex(profile_index)
        self.proximity_profile.blockSignals(False)

        state_labels = {
            "NEAR": "Vicino",
            "MID": "Intermedio",
            "FAR": "Lontano",
            "ABSENT": "Assente",
        }
        if proximity["available"]:
            self.proximity_state.setText(
                state_labels.get(proximity["state"], "Sconosciuto")
            )
            self.proximity_state.setStyleSheet(
                "color: #63c174;"
                if proximity["state"] == "NEAR"
                else "color: #aeb4bc;"
            )
        else:
            self.proximity_state.setText("Servizio non disponibile")
            self.proximity_state.setStyleSheet("color: #e06c75;")

        if master == "on":
            self.master_state.setText(
                "●  DeskUnlock attivo"
            )

            self.master_state.setStyleSheet(
                "color: #63c174;"
            )

            self.toggle_button.setText(
                "Disattiva"
            )

        elif master == "off":
            self.master_state.setText(
                "○  DeskUnlock disattivato"
            )

            self.master_state.setStyleSheet(
                "color: #aeb4bc;"
            )

            self.toggle_button.setText(
                "Attiva"
            )

        else:
            self.master_state.setText(
                "●  Stato degradato"
            )

            self.master_state.setStyleSheet(
                "color: #d5a14f;"
            )

            self.toggle_button.setText(
                "Ripristina"
            )

        phone = get_phone_info()

        self.phone_name.setText(
            phone["name"]
            if data["bonded"] > 0
            else "Nessun dispositivo associato"
        )

        self.device_action.hide()
        self.device_revoke.hide()

        if data["bonded"] == 0:
            self.phone_state.setText(
                "DeskUnlock non ha un telefono configurato"
            )
            self.phone_state.setStyleSheet(
                "color: #e06c75;"
            )

            self.device_action.setText(
                "Associa telefono"
            )
            self.device_action.setProperty(
                "action", "pair"
            )
            self.device_action.show()

        elif master == "degraded":
            self.phone_state.setText(
                "Associazione presente · Problema DeskUnlock"
            )
            self.phone_state.setStyleSheet(
                "color: #e06c75;"
            )

            self.device_action.setText(
                "Controlla"
            )
            self.device_action.setProperty(
                "action", "doctor"
            )
            self.device_action.show()

        elif phone["connected"]:
            self.phone_state.setText(
                "Associato a questo computer · Connesso"
            )
            self.phone_state.setStyleSheet(
                "color: #63c174;"
            )

        else:
            self.phone_state.setText(
                "Associato a questo computer · Non connesso"
            )
            self.phone_state.setStyleSheet(
                "color: #aeb4bc;"
            )

        if data["bonded"] > 0:
            self.device_revoke.show()

            if master != "degraded":
                self.device_action.setText(
                    "Cambia telefono"
                )
                self.device_action.setProperty(
                    "action", "change"
                )
                self.device_action.show()

        self.daemon_row.set_status(
            data["daemon"],
            "Attivo"
            if data["daemon"]
            else "Non attivo",
        )

        self.bluetooth_row.set_status(
            data["bluetooth"],
            "Disponibile"
            if data["bluetooth"]
            else "Non disponibile",
        )

        self.bond_row.set_status(
            data["bonded"] > 0,
            "Associato"
            if data["bonded"] > 0
            else "Non associato",
        )

        unlock_ok = (
            data["last_unlock"] != "Mai"
        )

        self.unlock_row.set_status(
            unlock_ok,
            data["last_unlock"],
        )

        self.toggle_button.setEnabled(
            not self.busy
        )
        self.device_action.setEnabled(not self.busy)
        self.device_revoke.setEnabled(not self.busy)

    def run_background_command(self, program, arguments, title):
        if self.command_process is not None:
            return

        self.busy = True
        self.command_title = title
        self.command_process = QProcess(self)
        self.command_process.setProcessChannelMode(
            QProcess.ProcessChannelMode.MergedChannels
        )
        self.command_process.finished.connect(
            self.background_command_finished
        )
        self.command_process.start(program, arguments)
        self.refresh()

    def background_command_finished(self, exit_code, _exit_status):
        process = self.command_process
        if process is None:
            return

        output = bytes(process.readAllStandardOutput()).decode(
            "utf-8",
            "replace",
        ).strip()
        process.deleteLater()
        self.command_process = None
        self.busy = False

        if exit_code == 0:
            QMessageBox.information(
                self,
                self.command_title,
                output or "Operazione completata.",
            )
        else:
            QMessageBox.critical(
                self,
                self.command_title,
                output or "Operazione non riuscita.",
            )
        self.refresh()

    def device_action_clicked(self):
        action = self.device_action.property(
            "action"
        )

        if action in ("pair", "change"):
            self.run_background_command(
                str(DEVICE_CONTROL),
                [action],
                "Associazione telefono",
            )
        elif action == "doctor":
            self.run_background_command(
                "syauth",
                ["doctor"],
                "Controllo DeskUnlock",
            )

    def revoke_device_clicked(self):
        answer = QMessageBox.question(
            self,
            "Dissocia telefono",
            (
                "Dissociare il telefono da DeskUnlock?\n\n"
                "Non potrà più autenticare o sbloccare "
                "questo computer.\n"
                "La password Linux resterà disponibile.\n\n"
                "Il normale pairing Bluetooth non verrà eliminato."
            ),
            QMessageBox.StandardButton.Yes
            | QMessageBox.StandardButton.Cancel,
            QMessageBox.StandardButton.Cancel,
        )

        if answer != QMessageBox.StandardButton.Yes:
            return

        try:
            result = subprocess.run(
                [
                    str(DEVICE_CONTROL),
                    "revoke",
                ],
                capture_output=True,
                text=True,
                timeout=15,
                check=False,
            )
        except Exception as exc:
            QMessageBox.critical(
                self,
                "Errore",
                "Dissociazione non riuscita.\n\n"
                + str(exc),
            )
            return

        if result.returncode != 0:
            message = (
                result.stderr.strip()
                or result.stdout.strip()
                or "Errore sconosciuto."
            )
            QMessageBox.critical(
                self,
                "Dissociazione non riuscita",
                message,
            )
            return

        QMessageBox.information(
            self,
            "Telefono dissociato",
            (
                "Il telefono è stato dissociato da DeskUnlock.\n\n"
                "Puoi associarne un altro con "
                "\"Associa telefono\"."
            ),
        )
        self.refresh()

    def toggle_master(self):
        if self.busy:
            return

        self.busy = True

        self.toggle_button.setEnabled(False)
        self.toggle_button.setText(
            "Attendere…"
        )

        current = get_master_state()

        if current == "on":
            action = "off"
        else:
            action = "on"

        self.process = QProcess(self)

        self.process.finished.connect(
            self.toggle_finished
        )

        self.process.start(
            str(CONTROL),
            [action],
        )

    def toggle_finished(self, *_):
        if self.process:
            self.process.deleteLater()
            self.process = None

        self.busy = False

        QTimer.singleShot(
            400,
            self.refresh,
        )


app = QApplication(sys.argv)

app.setApplicationName(
    "DeskUnlock Settings"
)

app.setDesktopFileName("syauth")

window = SettingsWindow()
window.show()

sys.exit(app.exec())
