        layout.setContentsMargins(18, 14, 18, 14)
        layout.setSpacing(10)

        header = QHBoxLayout()
        text = QVBoxLayout()
        text.setSpacing(2)

        title = QLabel("Proximity Lock")
        font = title.font()
        font.setBold(True)
        font.setPointSize(11)
        title.setFont(font)

        description = QLabel(
            "Blocca il PC quando il telefono si allontana"
        )
        description.setStyleSheet("color: #aeb4bc;")

        text.addWidget(title)
        text.addWidget(description)
        header.addLayout(text)
        header.addStretch()

        self.proximity_toggle = QCheckBox("Attivo")
        self.proximity_toggle.toggled.connect(
