        self.proximity_profile.addItem("Vicino", "near")
        self.proximity_profile.addItem("Bilanciato", "balanced")
        self.proximity_profile.addItem("Ampio", "wide")
        self.proximity_profile.activated.connect(
            self.set_proximity_profile
        )
        profile_row.addWidget(self.proximity_profile)
        layout.addLayout(profile_row)

        privacy = QLabel(
            "Privacy: RSSI, baseline e stato restano locali; "
