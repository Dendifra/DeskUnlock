        self.proximity_state.setStyleSheet("color: #aeb4bc;")
        state_row.addWidget(self.proximity_state)
        layout.addLayout(state_row)

        profile_row = QHBoxLayout()
        profile_row.addWidget(QLabel("Sensibilità"))
        profile_row.addStretch()
