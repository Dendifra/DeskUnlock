HOME = Path.home()


def helper_script(name):
    """Resolve a sibling helper next to this script.

    The package installs the GUI and its helpers side by side in
    ``/usr/bin``; a source checkout keeps them side by side in
    ``desktop/bin``. Resolving next to this file means a checkout runs
    its own helpers (so edits take effect immediately) instead of
    silently driving the packaged copy. Falls back to ``/usr/bin`` when
    no sibling exists.
    """
    sibling = Path(__file__).resolve().parent / name
    return sibling if sibling.is_file() else Path("/usr/bin") / name


CONTROL = helper_script("syauth-control")
DEVICE_CONTROL = helper_script("syauth-device")
PROXIMITY_CONTROL = helper_script("syauth-proximity")
IDLE_CONTROL = helper_script("syauth-idle-lock")
DESKUNLOCK_LOGO = Path("/usr/share/icons/hicolor/256x256/apps/deskunlock.png")


def deskunlock_icon():
    icon = QIcon(str(DESKUNLOCK_LOGO))
    return icon if not icon.isNull() else QIcon.fromTheme("security-high")


def run_command(command, timeout=2):
    try:
        result = subprocess.run(
            command,
            text=True,
            capture_output=True,
            timeout=timeout,
            check=False,
        )
        return result.stdout.strip()
    except Exception:
        return ""


def get_master_state():
    output = run_command([str(CONTROL), "status"])

    if "Syauth: ON" in output:
        return "on"

    if "Syauth: OFF" in output:
        return "off"

    return "degraded"


def format_unlock_timestamp(raw):
    """Format an RFC3339 UTC timestamp in the system's local timezone."""
    try:
        value = raw.strip()
        if value.endswith("Z"):
            value = f"{value[:-1]}+00:00"
        parsed = datetime.fromisoformat(value)
        if parsed.tzinfo is None:
            return raw
        local_time = parsed.astimezone()
        return local_time.strftime("%d/%m/%Y %H:%M")
    except (TypeError, ValueError):
        return raw


def get_syauth_state():
    status = run_command(["syauth", "status"])
    bonds = run_command(["syauth", "list"])

    bluetooth_ready = (
        "adapter-state:" in status
        and "Powered" in status
    )

    bonded = 0
    revoked = 0

    for line in bonds.splitlines():
        if re.search(r"\bbonded\b", line):
            bonded += 1

        if re.search(r"\brevoked", line):
            revoked += 1

    last_unlock = "Mai"

    match = re.search(r"last-successful-unlock:\s+(.+)", status)

    if match:
        raw = match.group(1).strip()

        if raw and raw != "never":
            last_unlock = raw.split("  ")[0]

            last_unlock = format_unlock_timestamp(last_unlock)

    return {
        "bluetooth": bluetooth_ready,
        "bonded": bonded,
        "revoked": revoked,
        "last_unlock": last_unlock,
    }


def get_proximity_diagnostics():
    output = run_command([str(PROXIMITY_CONTROL), "diagnostics"])
    values = {}
    for line in output.splitlines():
        key, separator, value = line.partition(": ")
        if separator:
            values[key.lower()] = value
    return values


def get_idle_settings():
    output = run_command([str(IDLE_CONTROL), "status"])
    values = {}
    for line in output.splitlines():
        key, separator, value = line.partition("=")
        if separator:
            values[key] = value
    try:
        minutes = int(values.get("idle_lock_minutes", "10"))
    except ValueError:
        minutes = 10
    return {
        "available": bool(output),
        "enabled": values.get("idle_lock_enabled", "1") == "1",
        "minutes": max(1, min(120, minutes)),
    }


def restart_idle_service():
    run_command(["systemctl", "--user", "restart", "syauth-idle-lock.service"])


def get_proximity_state():
    output = run_command([str(PROXIMITY_CONTROL), "status"])
    if not output:
        return {
            "available": False,
            "enabled": False,
            "state": "ABSENT",
            "profile_id": "balanced",
        }

    values = {}
    for line in output.splitlines():
        key, separator, value = line.partition("=")
        if separator:
            values[key] = value

    return {
        "available": True,
        "enabled": values.get("enabled") == "1",
        "state": values.get("state", "ABSENT"),
        "profile_id": values.get("profile_id", "balanced"),
    }


def proximity_display_state(proximity):
    if not proximity["available"]:
        return _("Servizio non disponibile"), False
    if not proximity["enabled"]:
        return _("Disattivato"), False
    if proximity["state"] == "ABSENT":
        # Watcher armed but the phone is not connected: nothing can lock or
        # unlock right now, so do not report "Attivo" (observed 2026-09-24:
        # the row said Attivo while the phone was disconnected).
        return _("Telefono assente"), False
    return {
        "NEAR": _("Vicino"),
        "MID": _("Intermedio"),
        "FAR": _("Lontano"),
    }.get(proximity["state"], _("Sconosciuto")), True


def association_display(bonded, present):
    """Return `(label, active)` for the "Associazione" row.

    A bond record is not an association. When the phone dissociates — or simply
    goes away — the desktop keeps the record but has nothing left to talk to,
    so the row must not read green (observed 2026-09-24: the card said
    "Associato" while the phone was dissociated and phone unlock was dead).
    """
    if bonded <= 0:
        return _("Non associato"), False
    if not present:
        return _("Telefono non connesso"), False
    return _("Associato"), True


def last_unlock_display(last_unlock, associated):
    """Return `(label, active)` for the "Ultimo sblocco" row.

    A past unlock proves nothing while no phone is associated: keep the
    timestamp readable, but only colour the row green when the association is
    actually live.
    """
    return last_unlock, bool(associated) and last_unlock != "Mai"


def get_phone_info():
    # The application bond is authoritative. A Bluetooth name is neither
    # unique nor a peer_id; never guess an address from a vendor/name match.
    active = []
    for line in run_command(["syauth", "list"]).splitlines():
        fields = line.split("\t")
        if len(fields) == 4 and fields[2] == "bonded":
            active.append(fields[1].strip() or "Telefono Android")

    return {
        "name": active[0] if len(active) == 1 else (
            _("Più telefoni associati") if active else _("Nessun dispositivo associato")
        ),
        # Existing bond records do not contain a Bluetooth address. Until a
        # peer-bound status is available, do not claim connected/disconnected.
        "connected": None,
        "paired": len(active) == 1,
    }


class StatusDot(QLabel):
    def __init__(self):
        super().__init__("●")
        self.setFixedWidth(18)

    def set_state(self, good):
        if good:
            self.setStyleSheet(
                "color: #63c174;"
                "font-size: 16px;"
            )
        else:
            self.setStyleSheet(
                "color: #8b929a;"
                "font-size: 16px;"
            )


def lock_screen_adapted(runtime=None):
    """Return the patched DMS lock tree, or None when no tree carries the hook.

    The fingerprint indicator used to be gated on a `pam_syauth.so` line inside
    the lock PAM stack. That line is gone for good: a DeskUnlock module in a
    stack that guards the login is how the operator ended up unable to get back
    in with the correct password — twice (2026-09-23). The phone unlock is out
    of band now: the lock screen calls `syauth unlock-request` on the operator's
    gesture. Every marker the patch writes must be present, so a half-applied
    adaptation (DMS moved an anchor) reads as broken instead of "Attivo".
    """
    runtime = runtime or Path(f"/run/user/{os.getuid()}/danklinux-shell")
    for tree in runtime.glob("*/"):
        content = tree / "Modules" / "Lock" / "LockScreenContent.qml"
        pam_qml = tree / "Modules" / "Lock" / "Pam.qml"
        if not (content.is_file() and pam_qml.is_file()):
            continue
        try:
            content_text = content.read_text(encoding="utf-8", errors="replace")
            pam_text = pam_qml.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if (
            "requestPhoneUnlock" in content_text
            and "syauthUnlockReady" in content_text
            and "syauthUnlockProcess" in content_text
            and "fprintSuppressedByPrimaryPam" in pam_text
        ):
            return tree
    return None


def dms_loaded_after(tree, marker=None):
    """True when the patch recorded that the running DMS loaded `tree`.

    DMS loads its extracted QML once and does not watch it, so a tree patched
    after DMS started is inert: the lock screen keeps the stock icon and never
    asks the phone. The patch writes `dms-lock-loaded` with the adapted tree
    name(s) right after it restarts DMS, and that marker — not the on-disk
    patch — is what says the running shell actually has the adaptation
    (2026-09-24).
    """
    marker = marker or Path(f"/run/user/{os.getuid()}/syauth/dms-lock-loaded")
    try:
        loaded = marker.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return False
    return tree.name in loaded.split(",")


# A phone presence heartbeat older than this means the phone is not connected.
PRESENCE_FRESH_SECONDS = 60


def phone_present():
    """True when the daemon saw a recent presence heartbeat from the phone."""
    marker = Path(f"/run/user/{os.getuid()}/syauth/presence.last")
    try:
        age = time.time() - marker.stat().st_mtime
    except OSError:
        return False
    return age < PRESENCE_FRESH_SECONDS


def fingerprint_unlock_health(master, bonded, runtime=None, marker=None, loaded_marker=None, present=None):
    """Return `(ok, reason)` for the fingerprint/phone unlock row.

    The GUI used to show "Attivo" whenever the tree was patched on disk, even
    when DMS had loaded the unpatched copy, the runtime marker was missing, or
    the daemon was down. Every failure now names itself so the row is honest.
    """
    if master != "on":
        return False, _("DeskUnlock disattivato")
    if bonded <= 0:
        return False, _("Nessun telefono")
    tree = lock_screen_adapted(runtime)
    if tree is None:
        return False, _("Lock screen non adattato")
    marker = marker or Path(f"/run/user/{os.getuid()}/syauth/unlock-ready")
    if not marker.is_file():
        return False, _("Sblocco telefono non armato")
    if not dms_loaded_after(tree, loaded_marker):
        return False, _("Riavvia DMS")
    if not (phone_present() if present is None else present):
        return False, _("Telefono non connesso")
    return True, "Attivo"


class StatusRow(QWidget):
    def __init__(self, title, icon_name=None):
        super().__init__()

        self.dot = StatusDot()
        self.good = False

        self.icon = None
        if icon_name is not None:
            icon = QIcon.fromTheme(icon_name)
            if not icon.isNull():
                self.icon = QLabel()
                self.icon.setPixmap(icon.pixmap(18, 18))

        self.title = QLabel(title)

        self.value = QLabel("")
        self.value.setAlignment(
            Qt.AlignmentFlag.AlignRight
            | Qt.AlignmentFlag.AlignVCenter
        )
        self.value.setStyleSheet(
            "color: #aeb4bc;"
        )

        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 4, 0, 4)
        layout.setSpacing(7)

        layout.addWidget(self.dot)
        if self.icon is not None:
            layout.addWidget(self.icon)
        layout.addWidget(self.title)
        layout.addStretch()
        layout.addWidget(self.value)

    def set_status(self, good, text):
        # Kept as an attribute so a test can assert the row's verdict directly
        # instead of reading Qt stylesheets back out.
        self.good = bool(good)
        self.dot.set_state(good)
        self.value.setText(text)


# Grace period granted to the pairing backend to exit after a Cancel
# command, before the independent watchdog SIGKILLs the session.
CANCEL_GRACE_SECONDS = 1.5


def new_session_process_parameters():
    """Return QProcess parameters that put the child in its own session.

    The pairing dialog launches a shell wrapper that in turn spawns the
    real ``syauth pair`` process. Without a private session, killing the
    wrapper leaves the real process orphaned. ``CreateNewSession`` makes
    the wrapper a session/process-group leader so
    :func:`terminate_process_tree` can signal the whole tree at once.

    Returns ``None`` when the Qt build predates ``UnixProcessParameters``
    (Qt < 6.6); callers then fall back to a plain ``start``.
    """
    parameters_type = getattr(QProcess, "UnixProcessParameters", None)
    flag_type = getattr(QProcess, "UnixProcessFlag", None)
    flag = getattr(flag_type, "CreateNewSession", None) if flag_type else None
    if parameters_type is None or flag is None:
        return None
    parameters = parameters_type()
    parameters.flags = flag
    return parameters


def kill_process_group(pid):
    """SIGKILL the process group led by ``pid``.

    Pure ``os``; safe to call from a non-Qt worker thread. Never raises:
    a group that already exited, or a signal the kernel refused, is a
    no-op. Falls back to the bare pid when the process is not a group
    leader.
    """
    if pid <= 0:
        return
    try:
        os.killpg(pid, signal.SIGKILL)
        return
    except OSError:
        pass
    try:
        os.kill(pid, signal.SIGKILL)
    except OSError:
        pass


def terminate_process_tree(process):
    """Reap ``process`` and every descendant it spawned.

    Reads the process-group id from ``process`` and delegates to
    :func:`kill_process_group`. Main-thread only (touches QProcess).
    """
    if process is None or process.state() == QProcess.ProcessState.NotRunning:
        return
    kill_process_group(process.processId())


class PairingDialog(QDialog):
    # Emitted by the watchdog thread after it SIGKILLs the pairing
    # process group. Qt delivers it to the main thread via a queued
    # connection, so the dialog is only ever closed there.
    cancel_watchdog_fired = Signal()

    def __init__(self, parent, mode):
        super().__init__(parent)
        self.setWindowTitle(_("Associa telefono — DeskUnlock"))
        self.setMinimumWidth(440)
        self.process = QProcess(self)
        self.process.setProcessChannelMode(QProcess.ProcessChannelMode.SeparateChannels)
        process_parameters = new_session_process_parameters()
        if process_parameters is not None:
            self.process.setUnixProcessParameters(process_parameters)
        self.process.readyReadStandardOutput.connect(self.read_events)
        self.process.finished.connect(self.finished)
        self.buffer = ""
        self.bonded = False
        self.cancel_requested = False
        self.cancel_watchdog = None
        self.cancel_watchdog_fired.connect(self._on_cancel_watchdog_fired)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 22, 24, 18)
        layout.setSpacing(12)
        title = QLabel(_("DeskUnlock"))
        title.setStyleSheet("font-size: 18px; font-weight: 600;")
        layout.addWidget(title)
        self.status = QLabel(_("Preparazione di DeskUnlock…"))
        self.status.setWordWrap(True)
        layout.addWidget(self.status)
        self.code = QLabel("")
        self.code.setStyleSheet("font-size: 28px; font-weight: 700; letter-spacing: 3px;")
        self.code.hide()
        layout.addWidget(self.code)
        buttons = QHBoxLayout()
        self.confirm = QPushButton(_("Conferma"))
        self.reject = QPushButton(_("Non corrisponde"))
        self.cancel = QPushButton(_("Annulla"))
        self.finish = QPushButton(_("Fine"))
        self.confirm.hide()
        self.reject.hide()
        self.finish.hide()
        self.confirm.clicked.connect(lambda: self.send("confirm"))
        self.reject.clicked.connect(lambda: self.send("reject"))
        self.cancel.clicked.connect(self.cancel_pairing)
        self.finish.clicked.connect(self.finish_pairing)
        buttons.addWidget(self.confirm)
        buttons.addWidget(self.reject)
        buttons.addStretch()
        buttons.addWidget(self.finish)
        buttons.addWidget(self.cancel)
        layout.addLayout(buttons)
        self.process.start(str(DEVICE_CONTROL), [mode, "--gui"])

    def closeEvent(self, event):
        if self.process is not None and self.process.state() != QProcess.ProcessState.NotRunning:
            self.cancel_pairing()
            event.ignore()
            return
        event.accept()

    def read_events(self):
        self.buffer += bytes(self.process.readAllStandardOutput()).decode("utf-8", "replace")
        while "\n" in self.buffer:
            line, self.buffer = self.buffer.split("\n", 1)
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            self.apply_event(event)

    def apply_event(self, event):
        kind = event.get("event")
        if kind == "preparing":
            self.status.setText(_("Preparazione di DeskUnlock…"))
        elif kind == "scan_started":
            self.status.setText(_("Cerco telefoni DeskUnlock nelle vicinanze…"))
        elif kind == "device_found":
            self.status.setText(_(f"Telefono trovato: {event.get('name', 'Telefono Android')}\nVerifica il codice Bluetooth sul telefono."))
        elif kind == "lesc_code":
            self.code.setText(event.get("code", ""))
            self.code.show()
            self.status.setText(_("Controlla che il codice Bluetooth coincida sui due dispositivi."))
            self.confirm.show()
            self.reject.show()
        elif kind == "oob_ready":
            self.code.setText(event.get("code", ""))
            self.code.show()
            self.status.setText(_("Controlla che questo numero coincida con quello mostrato sul telefono."))
            self.confirm.setEnabled(True)
            self.reject.setEnabled(True)
            self.confirm.show()
            self.reject.show()
        elif kind == "waiting_confirmation":
            self.status.setText(_("In attesa della tua conferma…"))
        elif kind == "bonded":
            self.bonded = True
            self.status.setText(_("Telefono associato"))
            self.confirm.hide()
            self.reject.hide()
            self.confirm.setEnabled(False)
            self.reject.setEnabled(False)
            self.cancel.hide()
            self.finish.show()
        elif kind == "error":
            self.status.setText(event.get("message", _("Associazione non completata.")))
            self.confirm.hide()
            self.reject.hide()
            self.cancel.setText(_("Chiudi"))

    def send(self, command):
        # NOTE: QProcess has no flush() in Qt 6. The previous code called
        # it, which raised AttributeError here and aborted cancel_pairing()
        # before the fallback was armed. QProcess buffers writes and Qt
        # flushes them; no explicit flush is needed.
        self.process.write((json.dumps({"command": command}) + "\n").encode())
        self.confirm.setEnabled(False)
        self.reject.setEnabled(False)

    def cancel_pairing(self):
        if self.process is None or self.process.state() == QProcess.ProcessState.NotRunning:
            self.accept()
            return
        if self.cancel_requested:
            return
        self.cancel_requested = True
        self.cancel.setText(_("Annullamento…"))
        self.cancel.setEnabled(False)
        self.confirm.setEnabled(False)
        self.reject.setEnabled(False)
        # Arm the independent watchdog BEFORE touching the process: the
        # fallback must not depend on the cancel write succeeding nor on
        # the Qt event loop delivering a timer.
        self._start_cancel_watchdog()
        try:
            self.send("cancel")
        except Exception:
            # A failed cancel write must never wedge the dialog: the
            # watchdog is already armed and reaps the session anyway.
            pass

    def _start_cancel_watchdog(self):
        """Arm the event-loop-independent cancel fallback (idempotent)."""
        if self.cancel_watchdog is not None:
            return
        pid = self.process.processId() if self.process is not None else 0
        watchdog = threading.Timer(
            CANCEL_GRACE_SECONDS,
            self._watchdog_kill,
            args=(pid,),
        )
        watchdog.daemon = True
        self.cancel_watchdog = watchdog
        watchdog.start()

    def _cancel_watchdog_timer(self):
        watchdog = self.cancel_watchdog
        self.cancel_watchdog = None
        if watchdog is not None:
            watchdog.cancel()

    def _watchdog_kill(self, pid):
        """Worker-thread fallback: SIGKILL the pairing process group.

        Touches no thread-unsafe Qt API; only emits a queued signal that
        Qt delivers on the dialog's main thread.
        """
        kill_process_group(pid)
        try:
            self.cancel_watchdog_fired.emit()
        except RuntimeError:
            # The dialog's C++ object is already gone; the kill above is
            # the part that matters.
            pass

    def _on_cancel_watchdog_fired(self):
        """Main-thread handler: close only this dialog, never the app."""
        self.cleanup_process()
        QDialog.reject(self)

    def finish_pairing(self):
        if self.process is None or self.process.state() == QProcess.ProcessState.NotRunning:
            self.cleanup_process()
        self.accept()

    def cleanup_process(self):
        self._cancel_watchdog_timer()
        process = self.process
        self.process = None
        if process is not None:
            terminate_process_tree(process)
            if process.state() != QProcess.ProcessState.NotRunning:
                process.waitForFinished(500)
            process.deleteLater()

    def finished(self, code, _status):
        self.cleanup_process()
        if self.bonded:
            return
        if self.cancel_requested:
            # Cancel closes the pairing dialog and returns to the main
            # window; it must never leave the dialog on "Annullamento…".
            QDialog.reject(self)
            return
        if code != 0:
            self.status.setText(_("Associazione non completata. Puoi riprovare."))
            self.confirm.hide()
            self.reject.hide()
            self.cancel.setText(_("Chiudi"))


# ---------------------------------------------------------------------------
# Grafica: tema chiaro/scuro
#
# L'app è disegnata su superfici scure. Segue il tema di sistema quando c'è,
# ma un lancio fuori sessione (unità systemd, ssh) non ha il tema del desktop e
# comparirebbe chiara: il tema è quindi esplicito e persistito, con un pulsante
# per cambiarlo. Il default è scuro.
# ---------------------------------------------------------------------------
THEME_DARK = "dark"
THEME_LIGHT = "light"
# ---------------------------------------------------------------------------
# Localisation.
#
# The source strings are English, so an English run needs no catalog at all:
# a language without a translation falls back to the source, never to a
# half-translated screen. The order is the operator's explicit choice in
# gui.conf, then the desktop's own locale, then English.
# ---------------------------------------------------------------------------
LOCALE_DIR = Path(os.environ.get("SYAUTH_LOCALE_DIR", "/usr/share/locale"))
TEXT_DOMAIN = "deskunlock"
SUPPORTED_LANGUAGES = ("en", "it")
DEFAULT_LANGUAGE = "en"



def resolve_language(env):
    """Return the language for this process, from the environment.

    The desktop locale decides, exactly as Android's locale decides for the app:
    there is no in-GUI override to keep in sync. A locale we have no catalog for
    falls back to [DEFAULT_LANGUAGE] rather than to a half-translated screen.
    """
    for key in ("LANGUAGE", "LC_ALL", "LANG"):
        raw = (env.get(key) or "").strip()
        if not raw:
            continue
        code = raw.split(":", 1)[0].split(".", 1)[0].split("_", 1)[0].lower()
        if code in SUPPORTED_LANGUAGES:
            return code
    return DEFAULT_LANGUAGE


def install_translations(language):
    """Bind the module-level `_` to `language`.

    Every supported language needs a catalog, English included: the source is
    Italian, so English exists only because the catalog says so. Treating English
    as the identity meant an English desktop read Italian — the whole point of
    the catalog is that it is the one thing that makes English real.

    A missing catalog falls back to the source, never to an empty screen.
    """
    global _
    try:
        translation = gettext.translation(
            TEXT_DOMAIN, localedir=str(LOCALE_DIR), languages=[language], fallback=True
        )
    except OSError:
        translation = gettext.NullTranslations()
    _ = translation.gettext


_ = lambda message: message  # replaced by install_translations() at startup


GUI_CONFIG_KEYS = ("theme",)

GUI_THEME_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "syauth" / "gui.conf"

HINT_COLOR = {"dark": "#aeb4bc", "light": "#4d545c"}


def read_gui_config():
    """Return every persisted GUI setting as a dict.

    Unknown keys are dropped so a hand-edited file cannot inject surprise.
    """
    values = {}
    try:
        for line in GUI_THEME_CONFIG.read_text(encoding="utf-8").splitlines():
            key, separator, value = line.partition("=")
            if separator and key in GUI_CONFIG_KEYS:
                values[key] = value.strip()
    except OSError:
        pass
    return values


def write_gui_config(**updates):
    """Merge `updates` into gui.conf instead of rewriting the file.

    The previous writer replaced the whole file, so saving the theme dropped
    every other setting; with two keys that is a bug waiting to happen. Values
    that are `None` are removed. Best-effort: a read-only config dir must not
    crash the GUI.
    """
    values = read_gui_config()
    for key, value in updates.items():
        if value is None:
            values.pop(key, None)
        else:
            values[key] = value
    body = "".join(f"{key}={values[key]}\n" for key in GUI_CONFIG_KEYS if key in values)
    try:
        GUI_THEME_CONFIG.parent.mkdir(parents=True, exist_ok=True)
        GUI_THEME_CONFIG.write_text(body, encoding="utf-8")
    except OSError:
        pass


def read_gui_theme():
    """Return the persisted theme, defaulting to dark."""
    theme = read_gui_config().get("theme")
    return theme if theme in (THEME_DARK, THEME_LIGHT) else THEME_DARK


def write_gui_theme(theme):
    """Persist the theme without disturbing the other settings."""
    write_gui_config(theme=theme)


def apply_theme(app, theme):
    """Apply `theme` to the whole application (palette + hint labels)."""
    app.setStyle("Fusion")
    if theme == THEME_LIGHT:
        app.setPalette(app.style().standardPalette())
    else:
        palette = QPalette()
        palette.setColor(QPalette.Window, QColor(46, 48, 52))
        palette.setColor(QPalette.WindowText, QColor(228, 230, 234))
        palette.setColor(QPalette.Base, QColor(38, 40, 43))
        palette.setColor(QPalette.AlternateBase, QColor(46, 48, 52))
        palette.setColor(QPalette.Text, QColor(228, 230, 234))
        palette.setColor(QPalette.Button, QColor(52, 55, 60))
        palette.setColor(QPalette.ButtonText, QColor(228, 230, 234))
        palette.setColor(QPalette.Highlight, QColor(53, 132, 228))
        palette.setColor(QPalette.HighlightedText, QColor(255, 255, 255))
        palette.setColor(QPalette.ToolTipBase, QColor(46, 48, 52))
        palette.setColor(QPalette.ToolTipText, QColor(228, 230, 234))
        palette.setColor(QPalette.PlaceholderText, QColor(150, 155, 162))
        palette.setColor(QPalette.Disabled, QPalette.Text, QColor(150, 155, 162))
        palette.setColor(QPalette.Disabled, QPalette.ButtonText, QColor(150, 155, 162))
        app.setPalette(palette)
    app.setStyleSheet(f'QLabel[role="hint"] {{ color: {HINT_COLOR[theme]}; }}')


class SettingsWindow(QMainWindow):
    def __init__(self):
        super().__init__()

        self.setWindowTitle(_("DeskUnlock"))
        self.setMinimumWidth(520)
        self.setMaximumWidth(620)

        icon = deskunlock_icon()

        if not icon.isNull():
            self.setWindowIcon(icon)

        self.busy = False
        self.process = None
        self.command_process = None
        self.command_title = ""

        root = QWidget()
        self.setCentralWidget(root)

        main = QVBoxLayout(root)
        main.setContentsMargins(28, 24, 28, 24)
        main.setSpacing(16)

        self.build_header(main)
        self.build_master(main)
        self.build_device(main)
        self.build_proximity(main)
        self.build_idle_lock(main)
        self.build_features(main)
        self.build_system_status(main)

        main.addStretch()

        footer = QHBoxLayout()

        self.theme = read_gui_theme()
        self.theme_button = QPushButton()
        self.theme_button.setMinimumWidth(150)
        self.theme_button.clicked.connect(self.toggle_theme)
        self.update_theme_button()

        footer.addWidget(self.theme_button)

        footer.addStretch()

        close_button = QPushButton(_("Chiudi"))
        close_button.setMinimumWidth(95)
        close_button.clicked.connect(self.close)

        footer.addWidget(close_button)

        main.addLayout(footer)

        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(2000)

        self.refresh()

        self.adjustSize()
        self.resize(
            max(self.width(), 540),
            min(self.height(), 760),
        )

    def section_title(self, text):
        label = QLabel(text)
        label.setStyleSheet(
            "font-size: 11px;"
            "font-weight: 600;"
            "color: #aeb4bc;"
        )
        return label

    def card(self):
        frame = QFrame()
        frame.setFrameShape(QFrame.Shape.StyledPanel)
        return frame

    def update_theme_button(self):
        """The label always starts with "Tema" and names the current theme."""
        self.theme_button.setText(
            _("Tema: scuro") if self.theme == THEME_DARK else _("Tema: chiaro")
        )

    def toggle_theme(self):
        """Switch the app theme immediately and remember the choice."""
        self.theme = THEME_LIGHT if self.theme == THEME_DARK else THEME_DARK
        apply_theme(QApplication.instance(), self.theme)
        write_gui_theme(self.theme)
        self.update_theme_button()

